# PostHog self-host env. Copy to `.env.posthog` (gitignored) and fill in.
# Consumed by `scripts/posthog-up.sh`, which symlinks it into
# `.posthog-server/.env.local` where upstream `bin/start` reads it.

# Hostname the PostHog proxy will serve. DNS must point here.
DOMAIN=posthog.example.com

# SECRET_KEY + cookie signing + ENCRYPTION_SALT_KEYS source. Long random.
# Generate one: `openssl rand -hex 32`
POSTHOG_SECRET=replace-me-with-openssl-rand-hex-32

# ENCRYPTION_SALT_KEYS — base64-encoded, comma-separated. bin/start generates
# a default if unset; leaving as `__GENERATE__` lets upstream handle it.
ENCRYPTION_SALT_KEYS=__GENERATE__

# Disable outbound PostHog Cloud pings (privacy + lower egress).
OPT_OUT_CAPTURE=false

# AI provider keys for PostHog's AI features. Leave blank if unused.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
