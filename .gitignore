# Claude Code tool state (local-only)
.claude/
.superpowers/

# Build output
dist/

# Dependencies
node_modules/

# Environment files
.env
.env.*
!.env.example
!.env.posthog.example

# Self-hosted PostHog server clone (created by scripts/posthog-up.sh)
.posthog-server/

# Editor directories
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Graphify output (generated, not source)
graphify-out/cache/
graphify-out/.graphify_*
graphify-out/graph.html
graphify-out/graph.json
graphify-out/manifest.json
graphify-out/cost.json

# Astro build cache
.astro/

# Test outputs
dist-configured/   # posthog-configured e2e output (ASTRO_OUT_DIR override)
dist-disabled/     # posthog-disabled e2e output
test-results/      # Playwright per-test failures + traces
tests/e2e/.preview-*.log

# Playwright artifacts
playwright-report/
.playwright/

# TypeScript cache
*.tsbuildinfo

# Package manager lockfiles (optional - uncomment if you don't commit them)
# package-lock.json
# pnpm-lock.yaml
# yarn.lock
