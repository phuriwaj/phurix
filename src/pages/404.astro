---
/**
 * /404 — Recover from a missed link.
 * Cite as: DESIGN.md §4 (/404) — display-scale h1 is earned here (Cohere: massive type sparingly).
 */
import Layout from '@/layouts/Layout.astro';
import { Button } from '@/components/ui/button';
---

<Layout title="404 — phurix">
  <meta name="robots" content="noindex" />
  <section class="container-phx section text-center py-18">
    <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral-text mb-4">Error 404</p>
    <h1 class="font-display font-normal text-heading leading-[1.0] tracking-display-tight text-[clamp(4.8rem,12vw,9.6rem)] mb-7">Page not found.</h1>
    <p class="font-serif text-body leading-[1.5] text-muted-slate max-w-[50ch] mx-auto">
      That page is no longer at this address. Try heading home, or browse the
      Garden.
    </p>

    <div class="flex flex-wrap gap-5 justify-center mt-15">
      <Button asChild variant="default" className="rounded-full h-auto px-6 py-3 text-base">
        <a href="/">← Back to Home</a>
      </Button>
      <Button asChild variant="outline" className="rounded-full h-auto px-6 py-3 text-base">
        <a href="/garden">Browse the Garden</a>
      </Button>
    </div>
  </section>
</Layout>