---
/**
 * Pattern detail — `/patterns/[slug]` (DESIGN.md §4 — read the pattern).
 * Same reading-frame as essay/notes detail.
 * Cite: DESIGN.md §4 (patterns detail).
 */
import Layout from '@/layouts/Layout.astro';
import TopicPhoto from '@/components/TopicPhoto.astro';
import { getCollection, render, getEntry } from 'astro:content';
import { pickArtTopic } from '@/lib/topics';
import { findBacklinks } from '@/lib/backlinks';

export async function getStaticPaths() {
  const patterns = await getCollection('patterns');
  return patterns.map((p) => ({
    params: { slug: p.id },
    props: { pattern: p },
  }));
}

const { pattern } = Astro.props;
const { Content } = await render(pattern);
const allTopics = pattern.data.topics ?? [];
const artTopic = pickArtTopic(allTopics);

const relatedRefs = pattern.data.related ?? [];
const relatedEntries = await Promise.all(
  relatedRefs.map((ref) => getEntry(ref))
);
const relatedItems = relatedEntries.filter((e): e is NonNullable<typeof e> => Boolean(e));

const allNotesForBacklinks = await getCollection('notes');
const allEssaysForBacklinks = await getCollection('essays');
const backlinkSources = [
  ...findBacklinks(pattern.id, 'patterns', allNotesForBacklinks),
  ...findBacklinks(pattern.id, 'patterns', allEssaysForBacklinks),
].filter(({ entry: source }) => source.id !== pattern.id);
---

<Layout
  title={`${pattern.data.title} — phurix`}
  description={pattern.data.lede}
  hideAnnouncement
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: pattern.data.title,
      datePublished: pattern.data.date.toISOString(),
      description: pattern.data.lede ?? '',
      keywords: (pattern.data.topics ?? []).join(', '),
      mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
    })}
  />
  <article class="py-15">
    <header class="container-phx max-w-[65ch] mx-auto mb-15">
      <p class="font-mono text-mono-label uppercase tracking-mono text-coral-text font-medium mb-5">
        <a href="/patterns" class="text-action-blue font-medium no-underline transition-colors duration-button ease hover:text-heading">← Patterns</a>
      </p>

      <div class="aspect-[4/3] rounded-lg overflow-hidden mb-8 max-w-[32rem] [&_svg]:w-full [&_svg]:h-full [&_svg]:block [&_img]:w-full [&_img]:h-full [&_img]:block">
        <TopicPhoto topic={artTopic} scale="md" showCredit={true} />
      </div>

      <h1 class="font-display text-card-heading font-normal text-heading leading-[1.15] tracking-display-tight mb-5">{pattern.data.title}</h1>
      <p class="font-serif text-body-lg leading-[1.5] text-muted-slate mb-7">{pattern.data.lede}</p>
      <div class="flex items-center gap-5 flex-wrap font-mono text-micro text-muted-slate tracking-mono uppercase">
        <time datetime={pattern.data.date.toISOString()} class="font-medium">
          {new Intl.DateTimeFormat('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          }).format(new Date(pattern.data.date))}
        </time>
      </div>
    </header>

    <div class="container-phx max-w-[65ch] mx-auto">
      <div class="prose">
        <Content />
      </div>
    </div>

    {relatedItems.length > 0 && (
      <aside class="container-phx max-w-[65ch] mx-auto mt-12 pt-7 border-t border-hairline">
        <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral-text mb-4">Used in:</p>
        <ul class="list-none p-0 m-0 font-serif text-body text-ink [&_a]:text-action-blue [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors [&_a]:duration-button [&_a]:ease [&_a:hover]:text-heading">
          {relatedItems.map((entry, i) => (
            <li>
              <a href={`/patterns/${entry.id}`}>{entry.data.title}</a>
              {i < relatedItems.length - 1 && <span class="text-muted-slate ms-[0.3em]"> · </span>}
            </li>
          ))}
        </ul>
      </aside>
    )}

    {backlinkSources.length > 0 && (
      <aside class="container-phx max-w-[65ch] mx-auto mt-12 pt-7 border-t border-hairline">
        <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral-text mb-4">Linked from:</p>
        <ul class="list-none p-0 m-0 font-serif text-body text-ink [&_a]:text-action-blue [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors [&_a]:duration-button [&_a]:ease [&_a:hover]:text-heading">
          {backlinkSources.map(({ entry: source, collection: coll }, i) => (
            <li>
              <span class="text-muted-slate font-mono text-micro me-[0.2em] tracking-mono">{coll}/</span>
              <a href={`/${coll}/${source.id}`}>{source.data.title}</a>
              {i < backlinkSources.length - 1 && <span class="text-muted-slate ms-[0.3em]"> · </span>}
            </li>
          ))}
        </ul>
      </aside>
    )}

    <footer class="container-phx max-w-[65ch] mt-15 pt-8 border-t border-hairline">
      <a href="/patterns" class="text-action-blue font-medium no-underline transition-colors duration-button ease hover:text-heading">← Back to all patterns</a>
    </footer>
  </article>
</Layout>
