---
/**
 * /talks — A sparse, external-link-heavy index of public speaking.
 * Cite as: DESIGN.md §4 (/talks) — row list mirrors bibliographic form.
 */
import Layout from '@/layouts/Layout.astro';
import TopicChip from '@/components/TopicChip.astro';
import { getCollection } from 'astro:content';

const allTalks = await getCollection('talks');
const talks = allTalks.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<Layout title="Talks" description="Conference talks and workshop sessions.">
  <section class="py-15 bg-canvas border-b border-hairline">
    <div class="container-phx">
      <h1 class="font-display font-normal text-heading leading-[1.1] tracking-display-tight text-[clamp(3.2rem,6vw,4.8rem)] mb-5">Talks</h1>
      <p class="font-serif text-body-lg leading-[1.5] text-muted-slate max-w-[60ch]">
        Conference talks and workshop sessions on design systems,
        component architecture, and the quieter ideas underneath.
      </p>
    </div>
  </section>

  <section class="container-phx section">
    {talks.length === 0 ? (
      <p class="font-serif italic text-body text-muted-slate">No talks to show — yet.</p>
    ) : (
      <ul class="list-none p-0 m-0">
        {talks.map((talk) => {
          const href = talk.data.link;
          const inner = (
            <>
              <div class="min-w-0">
                <h2 class="font-display text-feature-heading font-normal text-ink m-0 mb-4 tracking-display-tight transition-colors duration-button ease group-hover:text-action-blue">{talk.data.title}</h2>
                <p class="font-sans text-body leading-[1.5] text-muted-slate max-w-[65ch] m-0 mb-4">{talk.data.description}</p>
                {talk.data.event && (
                  <div class="flex">
                    <TopicChip label={talk.data.event} size="sm" />
                  </div>
                )}
              </div>
              <div class="flex flex-row md:justify-center items-center gap-4 font-mono">
                <time class="font-mono text-caption text-muted-slate tracking-mono" datetime={talk.data.date.toISOString()}>
                  {dateFmt.format(talk.data.date)}
                </time>
                {href && <span class="font-sans text-caption text-action-blue opacity-0 transition-opacity duration-button ease group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true">↗</span>}
              </div>
            </>
          );
          return (
            <li class="border-b border-hairline first:border-t border-hairline">
              {href ? (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="talk-row talk-link grid grid-cols-1 md:grid-cols-[1fr_12rem_10rem] gap-5 md:gap-12 py-8 text-inherit no-underline transition-colors duration-button ease items-center hover:text-action-blue group"
                >
                  {inner}
                </a>
              ) : (
                <div class="talk-row grid grid-cols-1 md:grid-cols-[1fr_12rem_10rem] gap-5 md:gap-12 py-8 items-center group">
                  {inner}
                </div>
              )}
            </li>
          );
        })}
      </ul>
    )}

    <p class="font-serif text-body text-muted-slate mt-12 [&_a]:text-action-blue [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors [&_a]:duration-button [&_a]:ease [&_a:hover]:text-heading">
      For workshop enquiries: <a href="/contact">contact me</a>.
    </p>
  </section>
</Layout>