---
/**
 * /projects — A short shelf of side projects.
 * Cite as: DESIGN.md §4 (/projects) — not in top nav; accessible via /about and footer.
 */
import Layout from '@/layouts/Layout.astro';
import TopicChip from '@/components/TopicChip.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<Layout title="Projects — phurix" description="Projects by phurix">
  <section class="py-15 bg-canvas border-b border-hairline">
    <div class="container-phx">
      <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral-text mb-4">Projects</p>
      <h1 class="font-display font-normal text-heading leading-[1.1] tracking-display-tight text-[clamp(3.2rem,6vw,4.8rem)] mb-5">Projects</h1>
      <p class="font-serif text-body-lg leading-[1.5] text-muted-slate max-w-[60ch]">
        A small selection of recent projects — case studies available on
        request.
      </p>
    </div>
  </section>

  <section class="container-phx section">
    <ul class="list-none p-0 m-0">
      {projects.map((p) => (
        <li id={p.id} class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between md:gap-12 py-8 border-b border-hairline first:border-t border-hairline">
          <div class="flex-1 min-w-0">
            <h2 class="font-display text-feature-heading font-normal text-ink m-0 mb-4 tracking-display-tight">{p.data.title}</h2>
            <p class="font-sans text-muted-slate leading-[1.5] m-0 mb-5 max-w-[60ch]">{p.data.desc}</p>
            {p.data.tags && p.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {p.data.tags.map((t) => <TopicChip label={t} size="sm" />)}
              </div>
            )}
          </div>
          {p.data.url && (
            <a
              href={p.data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block font-sans text-caption font-medium text-action-blue no-underline whitespace-nowrap transition-colors duration-button ease hover:text-heading hover:underline hover:underline-offset-2"
            >
              View project →
            </a>
          )}
        </li>
      ))}
    </ul>

    <p class="font-serif text-body text-muted-slate mt-12 [&_a]:text-action-blue [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors [&_a]:duration-button [&_a]:ease [&_a:hover]:text-heading">
      More on <a
        href="https://github.com/phurix"
        target="_blank"
        rel="noopener noreferrer"
      >github.com/phurix</a>.
    </p>
  </section>
</Layout>