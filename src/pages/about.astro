---
/**
 * /about — portrait of the author.
 * Cite as: DESIGN.md §4 (Layout — about-page structure, includes subscribe surface).
 */
import Layout from '@/layouts/Layout.astro';
import Card from '@/components/Card.astro';
import { Button } from '@/components/ui/button';
import Timeline from '@/components/Timeline.astro';
import TopicPhoto from '@/components/TopicPhoto.astro';
import TopicChip from '@/components/TopicChip.astro';
import NewsletterBand from '@/components/NewsletterBand.astro';
import GardenCard from '@/components/GardenCard.astro';
import CollectionGrid from '@/components/CollectionGrid.astro';
import { getCollection } from 'astro:content';
import { nowItems } from '@/data/now';

const workHistory = [
  {
    role: 'Senior Frontend Engineer',
    org: 'Clearhead',
    dates: '2022–Present',
    description: 'Building design systems and React component libraries for a remote-first product team.',
  },
  {
    role: 'Frontend Developer',
    org: 'Freelance',
    dates: '2019–2022',
    description: 'Worked with early-stage startups on landing pages, dashboards, and design system audits.',
  },
  {
    role: 'UI Designer',
    org: 'Studio Nitro',
    dates: '2017–2019',
    description: 'Designed interfaces for mobile apps and web products, collaborating closely with engineering.',
  },
  {
    role: 'Junior Designer',
    org: 'Agency RKT',
    dates: '2015–2017',
    description: 'Production design for marketing sites and branding projects.',
  },
];

const skills = [
  'TypeScript', 'React', 'Astro', 'CSS / Tailwind', 'Node.js', 'PostgreSQL', 'Figma', 'Design Systems',
];

const nowPreview = nowItems
  .filter((item): item is { label: string; value: string } => 'value' in item)
  .slice(0, 3);

const allProjects = await getCollection('projects');
const projects = allProjects
  .slice()
  .sort((a, b) => {
    const ay = a.data.year ?? 0;
    const by = b.data.year ?? 0;
    return by - ay;
  })
  .slice(0, 2);

const allTalks = await getCollection('talks');
const talks = allTalks
  .slice()
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Layout
  title="About — phurix"
  description="About Phuriwaj, web developer and designer based in Bangkok."
>
  <section class="py-15 md:py-15 bg-soft-stone border-b border-hairline">
    <div class="container-phx">
      <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral-text mb-4">About</p>
      <h1 class="font-display font-normal text-heading leading-[1.1] tracking-display-tight text-[clamp(3.2rem,6vw,4.8rem)] mb-5">Phuriwaj Ruengnaowaroj</h1>
      <p class="font-sans text-body-lg leading-[1.5] text-ink max-w-[60ch]">
        I'm a web developer and designer based in Bangkok, building
        thoughtful interfaces and the systems that hold them together.
      </p>
    </div>
  </section>

  <section class="container-phx section">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_18rem] gap-12 lg:gap-15 items-start">
      <div class="rounded-lg overflow-hidden order-first lg:order-none">
        <TopicPhoto topic="anthropology" scale="portrait" showCredit={true} />
      </div>
      <div class="prose max-w-[65ch]">
        <p>
          I'm a web developer and designer based in Bangkok, working at
          the intersection of design systems and the everyday interfaces
          that depend on them. I spend most of my time thinking about
          components — what makes them feel coherent, what makes them
          survive contact with real product work, and what makes them
          cheap to change.
        </p>
        <p>
          Before this I worked as a UI designer at small studios, then
          as a freelance frontend developer for early-stage startups. The
          throughline has always been the same: I want the software I
          ship to feel considered. Not polished for the sake of polish,
          but deliberate in the small decisions — typography, spacing,
          motion, the way a button looks when you press it.
        </p>
        <p>
          Outside of work I keep a small digital garden, read more than I
          probably should, and drink a lot of coffee. The notes and
          essays on this site are an attempt to think out loud about the
          craft — the patterns I'm noticing, the questions I'm chewing
          on, the things I keep changing my mind about.
        </p>
        <p>
          If you're working on something interesting, I'd love to hear
          about it.
        </p>
      </div>
    </div>
  </section>

  <section class="container-phx py-12 lg:py-15">
    <NewsletterBand />
  </section>

  <section class="container-phx section">
    <header class="mb-8">
      <h2 class="font-display text-card-heading font-normal text-heading">Now</h2>
    </header>
    <p class="font-serif text-body text-muted-slate mb-8 leading-[1.5]">
      A short preview of what I'm up to.
      <a href="/now" class="text-action-blue underline underline-offset-2 ms-4 transition-colors duration-button ease hover:text-heading">See the full /now →</a>
    </p>
    <div class="flex flex-col gap-5">
      {nowPreview.map((item) => (
        <div class="flex flex-wrap items-baseline gap-5">
          <span class="font-mono text-micro font-medium uppercase tracking-mono text-coral-text flex-shrink-0 min-w-[9rem]">{item.label}</span>
          <span class="font-sans text-body text-ink leading-[1.5]">{item.value}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="container-phx section">
    <header class="mb-8">
      <h2 class="font-display text-card-heading font-normal text-heading">Work History</h2>
    </header>
    <Timeline entries={workHistory} />
  </section>

  <section class="container-phx section">
    <header class="flex flex-wrap items-baseline justify-between gap-5 mb-8">
      <h2 class="font-display text-card-heading font-normal text-heading">Projects</h2>
      <Button asChild variant="outline" className="rounded-full h-auto px-6 py-3 text-base">
        <a href="/projects">All projects →</a>
      </Button>
    </header>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-7">
      {projects.map((p) => (
        <Card emphasis="bordered">
          <h3 class="font-display text-feature-heading font-normal text-heading mb-4 tracking-display-tight">{p.data.title}</h3>
          <p class="font-sans text-muted-slate leading-[1.5] mb-5">{p.data.desc}</p>
          <div class="flex flex-wrap gap-2 mb-7">
            {p.data.tags.map((t) => <TopicChip label={t} size="sm" />)}
          </div>
          <div class="mt-auto">
            {p.data.url ? (
              <Button asChild variant="outline" size="sm" className="rounded-full h-auto px-4 py-1.5 text-sm">
                <a href={p.data.url}>View project</a>
              </Button>
            ) : (
              <Button asChild variant="outline" size="sm" className="rounded-full h-auto px-4 py-1.5 text-sm">
                <a href="/contact">Discuss this project</a>
              </Button>
            )}
          </div>
        </Card>
      ))}
    </div>
  </section>

  <section class="container-phx section">
    <header class="flex flex-wrap items-baseline justify-between gap-5 mb-8">
      <h2 class="font-display text-card-heading font-normal text-heading">Talks</h2>
      <Button asChild variant="outline" className="rounded-full h-auto px-6 py-3 text-base">
        <a href="/talks">All talks →</a>
      </Button>
    </header>
    <CollectionGrid cols={3} gap="md">
      {talks.map((talk) => (
        <GardenCard
          title={talk.data.title}
          type="talk"
          excerpt={talk.data.description}
          date={talk.data.date}
          topics={[talk.data.event]}
          href={talk.data.link ?? '#'}
        />
      ))}
    </CollectionGrid>
  </section>

  <section class="container-phx section">
    <header class="mb-8">
      <h2 class="font-display text-card-heading font-normal text-heading">Skills</h2>
    </header>
    <ul class="list-none p-0 m-0 flex flex-wrap gap-4">
      {skills.map((s) => <li><TopicChip label={s} size="sm" /></li>)}
    </ul>
  </section>

  <section class="container-phx section pt-0">
    <div class="flex flex-wrap gap-5">
      <Button asChild variant="default" className="rounded-full h-auto px-6 py-3 text-base">
        <a href="/garden">See my work</a>
      </Button>
      <Button asChild variant="outline" className="rounded-full h-auto px-6 py-3 text-base">
        <a href="/contact">Get in touch</a>
      </Button>
    </div>
  </section>
</Layout>