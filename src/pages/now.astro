---
/**
 * /now — What the author is up to this month.
 * Cite as: DESIGN.md §4 (/now) — single ordered list, hairline dividers.
 * No announcement bar (deep-focus surface).
 */
import Layout from '@/layouts/Layout.astro';
import { nowItems, lastUpdated } from '@/data/now';

const lastUpdatedDate = new Date(lastUpdated);
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(lastUpdatedDate);
---

<Layout title="Now — phurix" description="What Phuriwaj is up to right now." hideAnnouncement>
  <section class="py-15 bg-canvas border-b border-hairline">
    <div class="container-phx">
      <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral-text mb-4">Now</p>
      <h1 class="font-display font-normal text-heading leading-[1.1] tracking-display-tight text-[clamp(3.2rem,6vw,4.8rem)] mb-5">What I'm up to</h1>
      <p class="font-serif text-body-lg leading-[1.5] text-muted-slate max-w-[60ch]">
        A snapshot of life right now — location, work, reading, and thoughts in
        progress. Updated occasionally, not on a schedule.
      </p>
      <p class="font-mono text-micro text-muted-slate mt-4 tracking-mono uppercase">
        Updated <time datetime={lastUpdatedDate.toISOString()}>{formattedDate}</time>
      </p>
    </div>
  </section>

  <section class="container-phx py-12">
    <dl class="list-none p-0 m-0 max-w-[65ch]">
      {nowItems.map((item) => (
        <div class="flex flex-col gap-4 py-8 border-b border-hairline first:border-t border-hairline">
          <dt class="font-mono text-mono-label font-medium text-coral-text uppercase tracking-mono m-0">{item.label}</dt>
          <dd class="m-0">
            {'value' in item ? (
              <p class="font-sans text-body leading-[1.5] text-ink m-0">{item.value}</p>
            ) : (
              <ul class="list-none p-0 m-0 flex flex-col gap-2">
                {item.list.map((entry) => (
                  <li class="font-sans text-body text-ink leading-[1.5] before:content-['—_'] before:text-muted-slate">{entry}</li>
                ))}
              </ul>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </section>
</Layout>