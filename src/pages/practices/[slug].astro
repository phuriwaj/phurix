---
/**
 * Practice detail — `/practices/[slug]`.
 * Mirrors /notes/[slug]: article header, prose body, growth badge, topics,
 * related. Adds a small `cadence` detail line in the header so readers can
 * tell at a glance whether this is daily, weekly, seasonal, or durable.
 * Cite as: MANIFESTO.md (pillar 2 — Living Well).
 */
import Layout from '@/layouts/Layout.astro';
import TopicChip from '@/components/TopicChip.astro';
import GrowthBadge from '@/components/GrowthBadge.astro';
import TopicPhoto from '@/components/TopicPhoto.astro';
import { getCollection, render, getEntry } from 'astro:content';
import { pickArtTopic } from '@/lib/topics';

export async function getStaticPaths() {
  const practices = await getCollection('practices');
  return practices.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allPractices = await getCollection('practices');
const sortedPractices = allPractices.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const currentIndex = sortedPractices.findIndex((p) => p.id === entry.id);
const prevPractice = currentIndex < sortedPractices.length - 1 ? sortedPractices[currentIndex + 1] : null;
const nextPractice = currentIndex > 0 ? sortedPractices[currentIndex - 1] : null;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(entry.data.date));

const artTopic = pickArtTopic(entry.data.topics);

const relatedRefs = entry.data.related ?? [];
const relatedEntries = await Promise.all(
  relatedRefs.map((ref) => getEntry(ref))
);
const relatedItems = relatedEntries.filter((e): e is NonNullable<typeof e> => Boolean(e));
---

<Layout title={entry.data.title} description={entry.data.excerpt} hideAnnouncement>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: entry.data.title,
      datePublished: entry.data.date.toISOString(),
      description: entry.data.excerpt ?? '',
      keywords: (entry.data.topics ?? []).join(', '),
      mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
    })}
  />
  <section class="section">
    <div class="container-phx">
      <a href="/practices" class="inline-block font-sans text-caption font-medium text-action-blue no-underline mb-8 transition-colors duration-button ease hover:text-heading">← Practices</a>

      <article class="max-w-[65ch] mx-auto [&_.prose]:leading-[1.65]">
        <header class="mb-12">
          {entry.data.growthStage === 'evergreen' && (
            <div class="aspect-[4/3] rounded-lg overflow-hidden mb-8 max-w-[32rem] [&_svg]:w-full [&_svg]:h-full [&_svg]:block [&_img]:w-full [&_img]:h-full [&_img]:block">
              <TopicPhoto topic={artTopic} scale="md" showCredit={true} />
            </div>
          )}

          <h1 class="font-display text-card-heading font-normal text-heading leading-[1.15] tracking-display-tight mb-5">{entry.data.title}</h1>

          <div class="flex items-center flex-wrap gap-4 mb-5 font-mono text-micro text-muted-slate tracking-mono uppercase">
            <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
            <span class="opacity-50">·</span>
            {entry.data.growthStage && (
              <GrowthBadge stage={entry.data.growthStage} size="md" />
            )}
            <span class="opacity-50">·</span>
            <span>{Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 220))} min read</span>
          </div>

          {entry.data.cadence && (
            <p class="font-sans text-caption text-muted-slate m-0 mb-5 flex gap-4 items-baseline">
              <span class="font-mono font-medium uppercase tracking-mono text-micro text-coral-text">Cadence:</span>
              <span class="font-serif italic text-ink">{entry.data.cadence}</span>
            </p>
          )}

          {entry.data.topics && entry.data.topics.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {entry.data.topics.map((t) => <TopicChip label={t} size="sm" href={`/garden?topic=${t}`} />)}
            </div>
          )}
        </header>

        <div class="prose">
          <Content />
        </div>

        {relatedItems.length > 0 && (
          <aside class="mt-12 pt-7 border-t border-hairline">
            <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral-text mb-4">Related:</p>
            <ul class="list-none p-0 m-0 font-serif text-body text-ink [&_a]:text-action-blue [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors [&_a]:duration-button [&_a]:ease [&_a:hover]:text-heading">
              {relatedItems.map((rel, i) => (
                <li>
                  <a href={`/practices/${rel.id}`}>{rel.data.title}</a>
                  {i < relatedItems.length - 1 && <span class="text-muted-slate ms-[0.3em]"> · </span>}
                </li>
              ))}
            </ul>
          </aside>
        )}

        <nav class="flex flex-wrap justify-between gap-5 mt-15 pt-8 border-t border-hairline">
          {prevPractice && (
            <a href={`/practices/${prevPractice.id}`} class="font-sans text-caption font-medium text-action-blue no-underline transition-colors duration-button ease hover:text-heading">
              ← {prevPractice.data.title}
            </a>
          )}
          {nextPractice && (
            <a href={`/practices/${nextPractice.id}`} class="font-sans text-caption font-medium text-action-blue no-underline transition-colors duration-button ease hover:text-heading ml-auto">
              {nextPractice.data.title} →
            </a>
          )}
        </nav>
      </article>
    </div>
  </section>
</Layout>
