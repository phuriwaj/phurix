---
/**
 * /contact — Three channels and one direct action.
 * Cite as: DESIGN.md §4 (/contact) — email-first per Sloan / Mod.
 */
import Layout from '@/layouts/Layout.astro';
import { Button } from '@/components/ui/button';
import Card from '@/components/Card.astro';

const channels = [
  { label: 'Email', value: 'hello@phurix.dev', href: 'mailto:hello@phurix.dev' },
  { label: 'GitHub', value: '@phurix', href: 'https://github.com/phurix' },
  { label: 'Mastodon', value: '@phurix@hachyderm.io', href: 'https://hachyderm.io/@phurix' },
];
---

<Layout title="Contact — phurix" description="Get in touch with phurix">
  <section class="py-15 bg-canvas border-b border-hairline">
    <div class="container-phx">
      <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral-text mb-4">Contact</p>
      <h1 class="font-display font-normal text-heading leading-[1.1] tracking-display-tight text-[clamp(3.2rem,6vw,4.8rem)] mb-5">Get in touch.</h1>
      <p class="font-serif text-body-lg leading-[1.5] text-muted-slate max-w-[60ch]">
        Three channels below — pick whichever fits. Email is best for anything
        that needs a back-and-forth.
      </p>
    </div>
  </section>

  <section class="container-phx section">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {channels.map((c) => (
        <Card emphasis="bordered">
          <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral-text m-0 mb-4">{c.label}</p>
          <a href={c.href} class="font-display text-feature-heading font-normal text-ink break-all no-underline tracking-display-tight hover:text-action-blue transition-colors duration-button ease">{c.value}</a>
        </Card>
      ))}
    </div>

    <div class="flex flex-wrap gap-5 mt-15">
      <Button asChild variant="default" className="rounded-full h-auto px-6 py-3 text-base">
        <a href="mailto:hello@phurix.dev">
        Email me directly
      </a>
      </Button>
    </div>
  </section>
</Layout>