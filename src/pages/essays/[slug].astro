---
/**
 * Essay detail — `/essays/[slug]` (DESIGN.md §4 — read the essay).
 * Lora 18px body via shared `.prose` utility (src/styles/global.css).
 * Title in display face, weight 400. back-link + meta row + topic chips.
 * Cite: DESIGN.md §4 (Layout — essays detail) + DESIGN.md §3 (Typography stack).
 */
import Layout from '@/layouts/Layout.astro';
import TopicChip from '@/components/TopicChip.astro';
import TopicPhoto from '@/components/TopicPhoto.astro';
import { getCollection, render, getEntry } from 'astro:content';
import { pickArtTopic } from '@/lib/topics';
import { findBacklinks } from '@/lib/backlinks';

export async function getStaticPaths() {
  const essays = await getCollection('essays');
  return essays.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allEssays = await getCollection('essays');
const sortedEssays = allEssays.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const currentIndex = sortedEssays.findIndex((e) => e.id === entry.id);
const prevEssay = currentIndex < sortedEssays.length - 1 ? sortedEssays[currentIndex + 1] : null;
const nextEssay = currentIndex > 0 ? sortedEssays[currentIndex - 1] : null;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(entry.data.date));

const artTopic = pickArtTopic(entry.data.topics);

const relatedRefs = entry.data.related ?? [];
const relatedResolved = await Promise.all(
  relatedRefs.map((ref) => getEntry(ref))
);
const relatedItems = relatedResolved.filter(
  (e): e is NonNullable<typeof e> => Boolean(e)
);

const allNotesForBacklinks = await getCollection('notes');
const allEssaysForBacklinks = await getCollection('essays');
const allPatternsForBacklinks = await getCollection('patterns');
const backlinkSources = [
  ...findBacklinks(entry.id, 'essays', allNotesForBacklinks),
  ...findBacklinks(entry.id, 'essays', allEssaysForBacklinks),
  ...findBacklinks(entry.id, 'essays', allPatternsForBacklinks),
].filter(({ entry: source }) => source.id !== entry.id);
---

<Layout title={`${entry.data.title} — phurix`} description={entry.data.lede} hideAnnouncement>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: entry.data.title,
      datePublished: entry.data.date.toISOString(),
      description: entry.data.lede,
      keywords: entry.data.topics.join(', '),
      mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
    })}
  />
  <section class="section">
    <div class="container-phx">
      <a href="/essays" class="inline-block font-sans text-caption font-medium text-action-blue no-underline mb-8 transition-colors duration-button ease hover:text-heading">← Essays</a>

      <article class="max-w-[65ch] mx-auto">
        <header class="mb-12">
          <div class="aspect-[16/9] rounded-lg overflow-hidden mb-8 [&_svg]:w-full [&_svg]:h-full [&_svg]:block [&_img]:w-full [&_img]:h-full [&_img]:block">
            <TopicPhoto topic={artTopic} scale="lg" showCredit={true} />
          </div>

          <h1 class="font-display text-card-heading font-normal text-heading leading-[1.15] tracking-display-tight mb-5">{entry.data.title}</h1>

          {entry.data.lede && <p class="font-serif text-body-lg text-muted-slate leading-[1.5] mb-7 italic">{entry.data.lede}</p>}

          <div class="flex items-center flex-wrap gap-4 mb-5 font-mono text-micro text-muted-slate tracking-mono uppercase">
            <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
            <span class="opacity-50">·</span>
            <span>{Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 220))} min read</span>
          </div>

          {entry.data.topics && entry.data.topics.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {entry.data.topics.map((t) => <TopicChip label={t} size="sm" href={`/garden?topic=${t}`} />)}
            </div>
          )}
        </header>

        <div class="prose">
          <Content />
        </div>

        <nav class="flex flex-wrap justify-between gap-5 mt-15 pt-8 border-t border-hairline">
          {prevEssay && (
            <a href={`/essays/${prevEssay.id}`} class="font-sans text-caption font-medium text-action-blue no-underline transition-colors duration-button ease hover:text-heading">
              ← {prevEssay.data.title}
            </a>
          )}
          {nextEssay && (
            <a href={`/essays/${nextEssay.id}`} class="font-sans text-caption font-medium text-action-blue no-underline transition-colors duration-button ease hover:text-heading ml-auto">
              {nextEssay.data.title} →
            </a>
          )}
        </nav>

        {(relatedItems.length > 0 || backlinkSources.length > 0) && (
          <aside class="mt-15 pt-8 border-t border-hairline flex flex-col gap-7">
            {relatedItems.length > 0 && (
              <section class="flex flex-col gap-4">
                <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral-text">Related</p>
                <ul class="list-none p-0 m-0 font-serif text-body text-ink [&_a]:text-action-blue [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors [&_a]:duration-button [&_a]:ease [&_a:hover]:text-heading">
                  {relatedItems.map((rel, i) => (
                    <li>
                      <a href={`/essays/${rel.id}`}>{rel.data.title}</a>
                      {i < relatedItems.length - 1 && <span class="text-muted-slate ms-[0.3em]"> · </span>}
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {relatedItems.length > 0 && backlinkSources.length > 0 && (
              <hr class="border-0 border-t border-hairline m-0" />
            )}

            {backlinkSources.length > 0 && (
              <section class="flex flex-col gap-4">
                <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral-text">Linked from</p>
                <ul class="list-none p-0 m-0 font-serif text-body text-ink [&_a]:text-action-blue [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors [&_a]:duration-button [&_a]:ease [&_a:hover]:text-heading">
                  {backlinkSources.map(({ entry: source, collection: coll }, i) => (
                    <li>
                      <span class="text-muted-slate font-mono text-micro me-[0.2em] tracking-mono">{coll}/</span>
                      <a href={`/${coll}/${source.id}`}>{source.data.title}</a>
                      {i < backlinkSources.length - 1 && <span class="text-muted-slate ms-[0.3em]"> · </span>}
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </aside>
        )}
      </article>
    </div>
  </section>
</Layout>
