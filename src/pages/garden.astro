---
import Layout from '@/layouts/Layout.astro';
import GardenCard from '@/components/GardenCard.astro';
import CollectionGrid from '@/components/CollectionGrid.astro';
import { getCollection } from 'astro:content';
import { findOnThisDay, type MergedEntry } from '@/lib/onThisDay';
import { normalize, hrefFor, dateFor, type AnyEntry } from '@/lib/entries';

const allEssays = await getCollection('essays');
const allNotes = await getCollection('notes');
const allTalks = await getCollection('talks');
const allPatterns = await getCollection('patterns');
const allPractices = await getCollection('practices');
const allProjects = await getCollection('projects');
const allBooks = await getCollection('books');

const allEntries: MergedEntry[] = [
  ...allEssays.map((e) => ({
    ...e,
    entryType: 'essay' as const,
    displayDate: e.data.date,
  })),
  ...allNotes.map((n) => ({
    ...n,
    entryType: 'note' as const,
    displayDate: n.data.date,
  })),
  ...allTalks.map((t) => ({
    ...t,
    entryType: 'talk' as const,
    displayDate: t.data.date,
  })),
  ...allPatterns.map((p) => ({
    ...p,
    entryType: 'pattern' as const,
    displayDate: p.data.date,
  })),
  ...allPractices.map((pr) => ({
    ...pr,
    entryType: 'practice' as const,
    displayDate: pr.data.date,
  })),
  ...allProjects.map((p) => ({
    ...p,
    entryType: 'project' as const,
    displayDate: dateFor(p),
  })),
  ...allBooks.map((b) => ({
    ...b,
    entryType: 'book' as const,
    displayDate: dateFor(b),
  })),
].sort((a, b) => b.displayDate.getTime() - a.displayDate.getTime());

const allTopics = [
  ...new Set(allEntries.flatMap((e) => normalize(e as AnyEntry).topics)),
].sort();

const today = new Date();
const onThisDayMatches = findOnThisDay(allEntries, today);
const onThisDay = onThisDayMatches[0] ?? null;
const onThisDayHref = onThisDay ? hrefFor(onThisDay) : '#';
const onThisDayYear = onThisDay ? onThisDay.displayDate.getFullYear() : today.getFullYear();
---

<Layout title="Garden" description="Everything I've written, in reverse chronological order.">
  <section class="page-header-section">
    <div class="container-phx">
      <h1 class="page-title">The Garden</h1>
      <p class="page-lede">
        Everything I've written, in reverse chronological order.
        Filter by type, topic, or growth stage.
      </p>
    </div>
  </section>

  {onThisDay && (
    <section class="on-this-day">
      <div class="container-phx">
        <p class="on-this-day-line">
          On this day in {onThisDayYear} — <a href={onThisDayHref}>{onThisDay.data.title}</a>
        </p>
      </div>
    </section>
  )}

  <section class="filter-section">
    <div class="container-phx">
      <details id="filter-details" class="filter-details" open>
        <summary class="filter-summary">
          <span class="filter-summary-label">Filters</span>
          <span class="filter-summary-icon" aria-hidden="true"></span>
        </summary>
        <div class="filter-body">
          <div class="filter-group">
            <span class="filter-label">Type</span>
            <div class="filter-chips" id="type-filters" role="radiogroup" aria-label="Filter by type">
              <button class="topic-chip topic-chip-md topic-chip-active" data-filter-type="all" role="radio" aria-checked="true" tabindex="0">All</button>
              <button class="topic-chip topic-chip-md" data-filter-type="note" role="radio" aria-checked="false" tabindex="-1">Note</button>
              <button class="topic-chip topic-chip-md" data-filter-type="essay" role="radio" aria-checked="false" tabindex="-1">Essay</button>
              <button class="topic-chip topic-chip-md" data-filter-type="talk" role="radio" aria-checked="false" tabindex="-1">Talk</button>
              <button class="topic-chip topic-chip-md" data-filter-type="pattern" role="radio" aria-checked="false" tabindex="-1">Pattern</button>
              <button class="topic-chip topic-chip-md" data-filter-type="practice" role="radio" aria-checked="false" tabindex="-1">Practice</button>
              <button class="topic-chip topic-chip-md" data-filter-type="project" role="radio" aria-checked="false" tabindex="-1">Project</button>
              <button class="topic-chip topic-chip-md" data-filter-type="book" role="radio" aria-checked="false" tabindex="-1">Book</button>
            </div>
          </div>

          <div class="filter-group">
            <span class="filter-label">Topic</span>
            <div class="filter-chips" id="topic-filters" role="radiogroup" aria-label="Filter by topic">
              <button class="topic-chip topic-chip-md topic-chip-active" data-filter-topic="all" role="radio" aria-checked="true" tabindex="0">All</button>
              {allTopics.map((topic) => (
                <button class="topic-chip topic-chip-md" data-filter-topic={topic} role="radio" aria-checked="false" tabindex="-1">{topic}</button>
              ))}
            </div>
          </div>

          <div class="filter-group">
            <span class="filter-label">Growth</span>
            <div class="filter-chips" id="growth-filters" role="radiogroup" aria-label="Filter by growth stage">
              <button class="topic-chip topic-chip-md topic-chip-active" data-filter-growth="all" role="radio" aria-checked="true" tabindex="0">All</button>
              <button class="topic-chip topic-chip-md" data-filter-growth="seedling" role="radio" aria-checked="false" tabindex="-1">Seedling</button>
              <button class="topic-chip topic-chip-md" data-filter-growth="growing" role="radio" aria-checked="false" tabindex="-1">Growing</button>
              <button class="topic-chip topic-chip-md" data-filter-growth="evergreen" role="radio" aria-checked="false" tabindex="-1">Evergreen</button>
            </div>
          </div>
        </div>
      </details>
    </div>
  </section>

  <section class="container-phx section">
    <div id="entries-grid">
      <CollectionGrid cols={3} gap="md">
      {allEntries.map((entry) => {
        const n = normalize(entry);
        return (
          <div
            class="entry-card-wrapper"
            data-type={n.type}
            data-topics={JSON.stringify(n.topics)}
            data-growth={n.growthStage ?? ''}
          >
            <GardenCard
              title={n.title}
              type={n.type}
              excerpt={n.excerpt}
              date={n.date}
              topics={n.topics}
              growthStage={n.growthStage}
              href={n.href}
              newSince={n.date}
            />
          </div>
        );
      })}
      </CollectionGrid>
      <p class="garden-empty" id="garden-empty" hidden>No matches — clear filters.</p>
    </div>

    <p class="garden-random-link">
      Or — <a href="/random">read something random</a>.
    </p>
  </section>
</Layout>

<style>
  .page-header-section {
    padding-block: var(--spacing-15) var(--spacing-10);
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 6vw, 4.8rem);
    font-weight: 400;
    color: var(--color-heading);
    line-height: 1.1;
    letter-spacing: var(--tracking-display-tight);
    margin-bottom: var(--spacing-5);
  }

  .page-lede {
    font-family: var(--font-sans);
    font-size: var(--text-body-lg);
    line-height: 1.5;
    color: var(--color-muted-slate);
    max-width: 60ch;
  }

  .on-this-day {
    padding-block: var(--spacing-7) var(--spacing-4);
    background: var(--color-soft-stone);
  }

  .on-this-day-line {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-body);
    color: var(--color-ink);
    margin: 0;
  }

  .on-this-day-line a {
    color: var(--color-action-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--duration-button) ease;
  }

  .on-this-day-line a:hover {
    color: var(--color-heading);
  }

  .filter-section {
    padding-block: var(--spacing-7);
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
    position: sticky;
    top: var(--nav-h-mobile);
    z-index: 10;
  }

  @media (min-width: 768px) {
    .filter-section { top: var(--nav-h); }
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: var(--spacing-5);
    margin-bottom: var(--spacing-5);
    flex-wrap: wrap;
  }

  .filter-group:last-child {
    margin-bottom: 0;
  }

  /* Mobile collapse — <details> wrapped; summary only visible <768px */
  .filter-summary {
    display: none;
  }

  .filter-summary::-webkit-details-marker {
    display: none;
  }

  .filter-summary-icon::before {
    content: '−';
  }

  .filter-details:not([open]) .filter-summary-icon::before {
    content: '+';
  }

  @media (max-width: 767px) {
    .filter-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--spacing-5);
      padding: var(--spacing-4) var(--spacing-5);
      border: 1px solid var(--color-hairline);
      border-radius: var(--radius-md);
      background: var(--color-soft-stone);
      font-family: var(--font-mono);
      font-size: var(--text-mono-label);
      text-transform: uppercase;
      letter-spacing: var(--tracking-mono);
      color: var(--color-ink);
      cursor: pointer;
      list-style: none;
    }

    .filter-summary:hover {
      border-color: var(--color-coral-text);
    }

    .filter-body {
      padding-block-start: var(--spacing-5);
    }

    .filter-details:not([open]) .filter-body {
      display: none;
    }
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    font-weight: 500;
    color: var(--color-coral-text);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    min-width: 4rem;
  }

  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .entry-card-wrapper {
    transition: opacity 0.2s ease;
  }

  .entry-card-wrapper.hidden {
    display: none;
  }

  .garden-empty {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-body);
    color: var(--color-muted-slate);
    text-align: center;
    padding-block: var(--spacing-15);
    margin: 0;
  }

  .garden-random-link {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-body);
    color: var(--color-muted-slate);
    text-align: center;
    margin-block-start: var(--spacing-12);
  }

  .garden-random-link a {
    color: var(--color-action-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--duration-button) ease;
  }

  .garden-random-link a:hover {
    color: var(--color-heading);
  }
</style>

<script>
  function initGardenFilter() {
    const grid = document.getElementById('entries-grid');
    if (!grid) return;

    let activeType = 'all';
    let activeTopic = 'all';
    let activeGrowth = 'all';

    const typeFilters = document.getElementById('type-filters');
    const topicFilters = document.getElementById('topic-filters');
    const growthFilters = document.getElementById('growth-filters');
    const emptyState = document.getElementById('garden-empty');

    function setActive(container: Element | null, selected: HTMLElement) {
      container?.querySelectorAll('button').forEach((b) => {
        b.classList.remove('topic-chip-active');
        b.setAttribute('aria-checked', 'false');
        b.setAttribute('tabindex', '-1');
      });
      selected.classList.add('topic-chip-active');
      selected.setAttribute('aria-checked', 'true');
      selected.setAttribute('tabindex', '0');
    }

    function applyFilters() {
      const cards = grid!.querySelectorAll('.entry-card-wrapper');
      let visibleCount = 0;
      cards.forEach((card) => {
        const cardType = card.getAttribute('data-type');
        const cardTopics = JSON.parse(card.getAttribute('data-topics') || '[]');
        const cardGrowth = card.getAttribute('data-growth') || '';

        const typeMatch = activeType === 'all' || cardType === activeType;
        const topicMatch = activeTopic === 'all' || cardTopics.includes(activeTopic);
        const growthMatch = activeGrowth === 'all' || cardGrowth === activeGrowth;

        if (typeMatch && topicMatch && growthMatch) {
          (card as HTMLElement).style.display = '';
          visibleCount += 1;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.removeAttribute('hidden');
        } else {
          emptyState.setAttribute('hidden', '');
        }
      }
    }

    function selectAtIndex(container: Element | null, index: number) {
      if (!container) return;
      const buttons = Array.from(container.querySelectorAll<HTMLElement>('button[role="radio"]'));
      if (buttons.length === 0) return;
      const wrapped = ((index % buttons.length) + buttons.length) % buttons.length;
      const target = buttons[wrapped];
      target.click();
      target.focus();
    }

    function handleChipClick(e: Event) {
      const btn = (e.target as HTMLElement).closest('button[data-filter-type], button[data-filter-topic], button[data-filter-growth]') as HTMLElement | null;
      if (!btn) return;

      if ('filterType' in btn.dataset) {
        activeType = btn.dataset.filterType ?? 'all';
        setActive(typeFilters, btn);
      } else if ('filterTopic' in btn.dataset) {
        activeTopic = btn.dataset.filterTopic ?? 'all';
        setActive(topicFilters, btn);
      } else if ('filterGrowth' in btn.dataset) {
        activeGrowth = btn.dataset.filterGrowth ?? 'all';
        setActive(growthFilters, btn);
      }

      applyFilters();
    }

    function handleChipKeydown(e: KeyboardEvent) {
      const target = e.target as HTMLElement;
      const btn = target.closest('button[role="radio"]') as HTMLElement | null;
      if (!btn) return;
      const container = btn.parentElement;
      if (!container) return;

      const buttons = Array.from(container.querySelectorAll<HTMLElement>('button[role="radio"]'));
      const currentIndex = buttons.indexOf(btn);

      switch (e.key) {
        case 'ArrowRight':
        case 'ArrowDown':
          e.preventDefault();
          selectAtIndex(container, currentIndex + 1);
          break;
        case 'ArrowLeft':
        case 'ArrowUp':
          e.preventDefault();
          selectAtIndex(container, currentIndex - 1);
          break;
        case 'Home':
          e.preventDefault();
          selectAtIndex(container, 0);
          break;
        case 'End':
          e.preventDefault();
          selectAtIndex(container, buttons.length - 1);
          break;
      }
    }

    typeFilters?.addEventListener('click', handleChipClick);
    topicFilters?.addEventListener('click', handleChipClick);
    growthFilters?.addEventListener('click', handleChipClick);

    typeFilters?.addEventListener('keydown', handleChipKeydown);
    topicFilters?.addEventListener('keydown', handleChipKeydown);
    growthFilters?.addEventListener('keydown', handleChipKeydown);

    const params = new URLSearchParams(window.location.search);

    const typeParam = params.get('type');
    if (typeParam && ['note', 'essay', 'talk', 'pattern', 'practice', 'project', 'book'].includes(typeParam)) {
      activeType = typeParam;
      const btn = typeFilters?.querySelector(`[data-filter-type="${typeParam}"]`) as HTMLElement | null;
      if (btn) {
        setActive(typeFilters, btn);
      }
    }

    const topicParam = params.get('topic');
    if (topicParam) {
      const btn = topicFilters?.querySelector(`[data-filter-topic="${topicParam}"]`) as HTMLElement | null;
      if (btn) {
        activeTopic = topicParam;
        setActive(topicFilters, btn);
      }
    }

    const growthParam = params.get('growth');
    if (growthParam && ['seedling', 'growing', 'evergreen'].includes(growthParam)) {
      activeGrowth = growthParam;
      const btn = growthFilters?.querySelector(`[data-filter-growth="${growthParam}"]`) as HTMLElement | null;
      if (btn) {
        setActive(growthFilters, btn);
      }
    }

    applyFilters();
  }

  initGardenFilter();
  document.addEventListener('astro:after-swap', initGardenFilter);

  function initFilterCollapse() {
    const details = document.getElementById('filter-details');
    if (!details) return;
    const mq = window.matchMedia('(max-width: 767px)');
    const sync = (e: MediaQueryListEvent | MediaQueryList) => {
      if (e.matches) {
        details.removeAttribute('open');
      } else {
        details.setAttribute('open', '');
      }
    };
    sync(mq);
    mq.addEventListener('change', sync);
  }

  initFilterCollapse();
  document.addEventListener('astro:after-swap', initFilterCollapse);
</script>
