---
import Layout from '@/layouts/Layout.astro';
import GardenCard from '@/components/GardenCard.astro';
import CollectionGrid from '@/components/CollectionGrid.astro';
import { getCollection } from 'astro:content';
import { findOnThisDay, type MergedEntry } from '@/lib/onThisDay';
import { normalize, hrefFor, dateFor, type AnyEntry } from '@/lib/entries';

const allEssays = await getCollection('essays');
const allNotes = await getCollection('notes');
const allTalks = await getCollection('talks');
const allPatterns = await getCollection('patterns');
const allPractices = await getCollection('practices');
const allProjects = await getCollection('projects');
const allBooks = await getCollection('books');

const allEntries: MergedEntry[] = [
  ...allEssays.map((e) => ({ ...e, entryType: 'essay' as const, displayDate: e.data.date })),
  ...allNotes.map((n) => ({ ...n, entryType: 'note' as const, displayDate: n.data.date })),
  ...allTalks.filter((t) => t.data.link).map((t) => ({ ...t, entryType: 'talk' as const, displayDate: t.data.date })),
  ...allPatterns.map((p) => ({ ...p, entryType: 'pattern' as const, displayDate: p.data.date })),
  ...allPractices.map((pr) => ({ ...pr, entryType: 'practice' as const, displayDate: pr.data.date })),
  ...allProjects.map((p) => ({ ...p, entryType: 'project' as const, displayDate: dateFor(p) })),
  ...allBooks.map((b) => ({ ...b, entryType: 'book' as const, displayDate: dateFor(b) })),
].sort((a, b) => b.displayDate.getTime() - a.displayDate.getTime());

const allTopics = [...new Set(allEntries.flatMap((e) => normalize(e as AnyEntry).topics))].sort();

const today = new Date();
const onThisDayMatches = findOnThisDay(allEntries, today);
const onThisDayItems = onThisDayMatches.map((m) => ({
  title: m.data.title,
  href: hrefFor(m),
  year: m.displayDate.getFullYear(),
}));

// Filter chip shared base style — matches TopicChip 'md' outline.
// aria-checked toggles active visual via utility classes below.
const chipBase = 'inline-block font-mono uppercase tracking-[0.02em] bg-transparent text-coral-text border border-coral cursor-pointer leading-relaxed text-button py-1 px-3 rounded-pill transition-[background-color,color,border-color] duration-200 aria-checked:bg-coral aria-checked:text-cohere-black aria-checked:border-coral hover:bg-coral/10 aria-checked:hover:bg-soft-coral aria-checked:hover:border-soft-coral';
---

<Layout title="Garden" description="Everything I've written, in reverse chronological order.">
  <section class="py-15 bg-canvas border-b border-hairline">
    <div class="container-phx">
      <h1 class="font-display font-normal text-heading leading-[1.1] tracking-display-tight text-[clamp(3.2rem,6vw,4.8rem)] mb-5">The Garden</h1>
      <p class="font-sans text-body-lg leading-[1.5] text-muted-slate max-w-[60ch]">
        Everything I've written, in reverse chronological order.
        Filter by type, topic, or growth stage.
      </p>
    </div>
  </section>

  {onThisDayItems.length > 0 && (
    <section class="py-7 pb-4 bg-soft-stone">
      <div class="container-phx">
        <p class="font-serif italic text-body text-ink m-0 [&_a]:text-action-blue [&_a]:underline [&_a]:underline-offset-2 [&_a]:transition-colors [&_a]:duration-button [&_a]:ease [&_a:hover]:text-heading">
          On this day —{' '}
          {onThisDayItems.map((item, i) => (
            <span>
              {i > 0 && ', '}
              <a href={item.href}>{item.title}</a>
              <span class="font-serif italic text-muted-slate text-caption ms-1"> ({item.year})</span>
            </span>
          ))}
        </p>
      </div>
    </section>
  )}

  <section class="py-7 bg-canvas border-b border-hairline sticky top-14 md:top-[7.2rem] z-10">
    <div class="container-phx">
      <details id="filter-details" class="group max-md:border max-md:border-hairline max-md:rounded-md max-md:bg-soft-stone [&[open]]:max-md:pb-0" open>
        <summary class="list-none cursor-pointer max-md:flex max-md:items-center max-md:justify-between max-md:gap-5 max-md:py-4 max-md:px-5 max-md:font-mono max-md:text-mono-label max-md:uppercase max-md:tracking-mono max-md:text-ink max-md:hover:border-coral-text">
          <span class="max-md:inline hidden">Filters</span>
          <span class="hidden max-md:inline" aria-hidden="true">+</span>
          <span class="hidden group-open:max-md:inline" aria-hidden="true">−</span>
        </summary>
        <div class="max-md:pt-5">
          <div class="flex items-center flex-wrap gap-5 mb-5 last:mb-0">
            <span class="font-mono text-mono-label font-medium text-coral-text uppercase tracking-mono min-w-16">Type</span>
            <div id="type-filters" role="radiogroup" aria-label="Filter by type" class="flex flex-wrap gap-2">
              <button class={chipBase} data-filter-type="all" role="radio" aria-checked="true" tabindex="0">All</button>
              <button class={chipBase} data-filter-type="note" role="radio" aria-checked="false" tabindex="-1">Note</button>
              <button class={chipBase} data-filter-type="essay" role="radio" aria-checked="false" tabindex="-1">Essay</button>
              <button class={chipBase} data-filter-type="talk" role="radio" aria-checked="false" tabindex="-1">Talk</button>
              <button class={chipBase} data-filter-type="pattern" role="radio" aria-checked="false" tabindex="-1">Pattern</button>
              <button class={chipBase} data-filter-type="practice" role="radio" aria-checked="false" tabindex="-1">Practice</button>
              <button class={chipBase} data-filter-type="project" role="radio" aria-checked="false" tabindex="-1">Project</button>
              <button class={chipBase} data-filter-type="book" role="radio" aria-checked="false" tabindex="-1">Book</button>
            </div>
          </div>

          <div class="flex items-center flex-wrap gap-5 mb-5 last:mb-0">
            <span class="font-mono text-mono-label font-medium text-coral-text uppercase tracking-mono min-w-16">Topic</span>
            <div id="topic-filters" role="radiogroup" aria-label="Filter by topic" class="flex flex-wrap gap-2">
              <button class={chipBase} data-filter-topic="all" role="radio" aria-checked="true" tabindex="0">All</button>
              {allTopics.map((topic) => (
                <button class={chipBase} data-filter-topic={topic} role="radio" aria-checked="false" tabindex="-1">{topic}</button>
              ))}
            </div>
          </div>

          <div class="flex items-center flex-wrap gap-5 mb-5 last:mb-0">
            <span class="font-mono text-mono-label font-medium text-coral-text uppercase tracking-mono min-w-16">Growth</span>
            <div id="growth-filters" role="radiogroup" aria-label="Filter by growth stage" class="flex flex-wrap gap-2">
              <button class={chipBase} data-filter-growth="all" role="radio" aria-checked="true" tabindex="0">All</button>
              <button class={chipBase} data-filter-growth="seedling" role="radio" aria-checked="false" tabindex="-1">Seedling</button>
              <button class={chipBase} data-filter-growth="growing" role="radio" aria-checked="false" tabindex="-1">Growing</button>
              <button class={chipBase} data-filter-growth="evergreen" role="radio" aria-checked="false" tabindex="-1">Evergreen</button>
            </div>
          </div>
        </div>
      </details>
    </div>
  </section>

  <section class="container-phx section">
    <div id="entries-grid">
      <CollectionGrid cols={3} gap="md">
        {allEntries.map((entry) => {
          const n = normalize(entry);
          return (
            <div
              class="transition-opacity duration-200"
              data-type={n.type}
              data-topics={n.topics.join(' ')}
              data-growth={n.growthStage ?? ''}
            >
              <GardenCard
                title={n.title}
                type={n.type}
                excerpt={n.excerpt}
                date={n.date}
                topics={n.topics}
                growthStage={n.growthStage}
                href={n.href}
                newSince={n.date}
              />
            </div>
          );
        })}
      </CollectionGrid>
      <p class="font-serif italic text-body text-muted-slate text-center py-15 m-0" id="garden-empty" hidden>No matches — clear filters.</p>
    </div>

    <p class="font-serif italic text-body text-muted-slate text-center mt-12">
      Or — <a href="/random" class="text-action-blue underline underline-offset-2 transition-colors duration-button ease hover:text-heading">read something random</a>.
    </p>
  </section>
</Layout>

<script>
  function initGardenFilter() {
    const grid = document.getElementById('entries-grid');
    if (!grid) return;

    let activeType = 'all';
    let activeTopic = 'all';
    let activeGrowth = 'all';

    const typeFilters = document.getElementById('type-filters');
    const topicFilters = document.getElementById('topic-filters');
    const growthFilters = document.getElementById('growth-filters');
    const emptyState = document.getElementById('garden-empty');

    function setActive(container: Element | null, selected: HTMLElement) {
      container?.querySelectorAll('button').forEach((b) => {
        b.setAttribute('aria-checked', 'false');
        b.setAttribute('tabindex', '-1');
      });
      selected.setAttribute('aria-checked', 'true');
      selected.setAttribute('tabindex', '0');
    }

    function applyFilters() {
      const cards = grid!.querySelectorAll<HTMLElement>('[data-type]');
      let visibleCount = 0;
      cards.forEach((card) => {
        const cardType = card.getAttribute('data-type');
        const cardTopics = (card.getAttribute('data-topics') || '').split(' ').filter(Boolean);
        const cardGrowth = card.getAttribute('data-growth') || '';

        const typeMatch = activeType === 'all' || cardType === activeType;
        const topicMatch = activeTopic === 'all' || cardTopics.includes(activeTopic);
        const growthMatch = activeGrowth === 'all' || cardGrowth === activeGrowth;

        if (typeMatch && topicMatch && growthMatch) {
          card.style.display = '';
          visibleCount += 1;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.removeAttribute('hidden');
        } else {
          emptyState.setAttribute('hidden', '');
        }
      }
    }

    function selectAtIndex(container: Element | null, index: number) {
      if (!container) return;
      const buttons = Array.from(container.querySelectorAll<HTMLElement>('button[role="radio"]'));
      if (buttons.length === 0) return;
      const wrapped = ((index % buttons.length) + buttons.length) % buttons.length;
      const target = buttons[wrapped];
      target.click();
      target.focus();
    }

    function handleChipClick(e: Event) {
      const btn = (e.target as HTMLElement).closest('button[data-filter-type], button[data-filter-topic], button[data-filter-growth]') as HTMLElement | null;
      if (!btn) return;

      if ('filterType' in btn.dataset) {
        activeType = btn.dataset.filterType ?? 'all';
        setActive(typeFilters, btn);
      } else if ('filterTopic' in btn.dataset) {
        activeTopic = btn.dataset.filterTopic ?? 'all';
        setActive(topicFilters, btn);
      } else if ('filterGrowth' in btn.dataset) {
        activeGrowth = btn.dataset.filterGrowth ?? 'all';
        setActive(growthFilters, btn);
      }

      applyFilters();
    }

    function handleChipKeydown(e: KeyboardEvent) {
      const target = e.target as HTMLElement;
      const btn = target.closest('button[role="radio"]') as HTMLElement | null;
      if (!btn) return;
      const container = btn.parentElement;
      if (!container) return;

      const buttons = Array.from(container.querySelectorAll<HTMLElement>('button[role="radio"]'));
      const currentIndex = buttons.indexOf(btn);

      switch (e.key) {
        case 'ArrowRight':
        case 'ArrowDown':
          e.preventDefault();
          selectAtIndex(container, currentIndex + 1);
          break;
        case 'ArrowLeft':
        case 'ArrowUp':
          e.preventDefault();
          selectAtIndex(container, currentIndex - 1);
          break;
        case 'Home':
          e.preventDefault();
          selectAtIndex(container, 0);
          break;
        case 'End':
          e.preventDefault();
          selectAtIndex(container, buttons.length - 1);
          break;
      }
    }

    typeFilters?.addEventListener('click', handleChipClick);
    topicFilters?.addEventListener('click', handleChipClick);
    growthFilters?.addEventListener('click', handleChipClick);

    typeFilters?.addEventListener('keydown', handleChipKeydown);
    topicFilters?.addEventListener('keydown', handleChipKeydown);
    growthFilters?.addEventListener('keydown', handleChipKeydown);

    const params = new URLSearchParams(window.location.search);

    const typeParam = params.get('type');
    if (typeParam && ['note', 'essay', 'talk', 'pattern', 'practice', 'project', 'book'].includes(typeParam)) {
      activeType = typeParam;
      const btn = typeFilters?.querySelector(`[data-filter-type="${typeParam}"]`) as HTMLElement | null;
      if (btn) {
        setActive(typeFilters, btn);
      }
    }

    const topicParam = params.get('topic');
    if (topicParam) {
      const btn = topicFilters?.querySelector(`[data-filter-topic="${topicParam}"]`) as HTMLElement | null;
      if (btn) {
        activeTopic = topicParam;
        setActive(topicFilters, btn);
      }
    }

    const growthParam = params.get('growth');
    if (growthParam && ['seedling', 'growing', 'evergreen'].includes(growthParam)) {
      activeGrowth = growthParam;
      const btn = growthFilters?.querySelector(`[data-filter-growth="${growthParam}"]`) as HTMLElement | null;
      if (btn) {
        setActive(growthFilters, btn);
      }
    }

    applyFilters();
  }

  initGardenFilter();
  document.addEventListener('astro:after-swap', initGardenFilter);

  function initFilterCollapse() {
    const details = document.getElementById('filter-details');
    if (!details) return;
    const mq = window.matchMedia('(max-width: 767px)');
    const sync = (e: MediaQueryListEvent | MediaQueryList) => {
      if (e.matches) {
        details.removeAttribute('open');
      } else {
        details.setAttribute('open', '');
      }
    };
    sync(mq);
    mq.addEventListener('change', sync);
  }

  initFilterCollapse();
  document.addEventListener('astro:after-swap', initFilterCollapse);
</script>