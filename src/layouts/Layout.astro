---
import '@/styles/global.css';
import '@/styles/dark.css';
// @ts-expect-error — @fontsource-variable/inter ships JS-only with no types
import '@fontsource-variable/inter';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import AnnouncementBar from '@/components/AnnouncementBar.astro';

interface Props {
  title: string;
  description?: string;
  /** Hide the announcement bar (e.g. on deep-focus pages like /now). */
  hideAnnouncement?: boolean;
}

const {
  title,
  description = 'Personal website of Phuriwaj Ruengnaowaroj',
  hideAnnouncement = false,
} = Astro.props;
const fullTitle = title === 'phurix' ? title : `${title} — phurix`;
---

<!doctype html>
<html lang="en">
  <head>
    {/* Anti-FOUC: resolve theme synchronously before first paint.
        1. localStorage('phurix-theme') — explicit user choice wins.
        2. prefers-color-scheme — fall back to OS preference.
        Also subscribes to OS changes; only follows them when the user has
        NOT made an explicit choice. */}
    <script is:inline>
      (function () {
        function resolve() {
          try {
            var stored = localStorage.getItem('phurix-theme');
            if (stored === 'light' || stored === 'dark') return stored;
            return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          } catch (e) { return 'light'; }
        }

        // Initial paint — set theme on current document.
        document.documentElement.dataset.theme = resolve();

        // Soft navigation: apply theme to the INCOMING document before
        // ClientRouter swaps it in. Without this, the new <html> arrives
        // without data-theme and the page flashes/settles to light.
        document.addEventListener('astro:before-swap', function (event) {
          event.newDocument.documentElement.dataset.theme = resolve();
        });

        // React to OS-level preference changes — only when the user hasn't
        // explicitly chosen. Safari < 14 (Sept 2020) had a deprecated
        // addListener API; we now require addEventListener, which is
        // universal in 2026.
        var mq = matchMedia('(prefers-color-scheme: dark)');
        mq.addEventListener('change', function (e) {
          try {
            if (localStorage.getItem('phurix-theme')) return;
          } catch (_) { /* fall through */ }
          document.documentElement.dataset.theme = e.matches ? 'dark' : 'light';
        });
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:type" content={Astro.url.pathname === '/' ? 'website' : 'article'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:site_name" content="phurix" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title="phurix" href={new URL('rss.xml', Astro.site).href} />

    {/* Lora (serif) and Space Grotesk (display) — build-time downloaded via Astro Fonts API. */}
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-display" preload />

    {/* PostHog analytics — bundled once by Vite, deduped across pages.
        No-op when PUBLIC_POSTHOG_KEY is unset (see src/scripts/posthog-init.ts).
        engagement.ts self-guards on `.prose` presence so it's safe to import
        globally; it only fires scroll/copy/code-copy events on detail pages.
        newsletter.ts tracks every form marked data-newsletter (NewsletterBand
        + Footer + anywhere else). */}
    <script>
      import '@/scripts/posthog-init';
      import '@/scripts/engagement';
      import '@/scripts/newsletter';
    </script>

    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-near-black focus:text-white focus:px-4 focus:py-2 focus:rounded-pill"
    >
      Skip to content
    </a>

    {!hideAnnouncement && <AnnouncementBar />}

    <Nav />

    <main id="main">
      {/* PageHeader slot — h1 + lede for collection pages */}
      <slot name="page-header" />
      <slot />
    </main>

    <Footer />
  </body>
</html>
