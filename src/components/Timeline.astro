---
/**
 * Timeline — vertical timeline for /about work history.
 * Shows role + org + dates + 1-line description.
 */
export interface TimelineEntry {
  role: string;
  org: string;
  dates: string;
  description: string;
}

interface Props {
  entries: TimelineEntry[];
  class?: string;
}

const { entries, class: className = '' } = Astro.props;
---

<ol class:list={['list-none p-0 m-0 relative flex flex-col gap-0 before:content-[""] before:absolute before:left-[7px] before:top-2 before:bottom-2 before:w-0.5 before:bg-hairline before:rounded-sm', className]}>
  {entries.map((entry) => (
    <li class="relative ps-10 pb-8 last:pb-0">
      <div class="absolute left-0 top-1.5 w-4 h-4 rounded-full bg-canvas border border-ink" aria-hidden="true" />
      <div class="flex flex-col gap-2">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <div>
            <span class="font-display text-body font-medium text-ink tracking-display-tight">{entry.role}</span>
            <span class="text-muted-slate font-normal"> — </span>
            <span class="font-sans text-body text-ink font-normal">{entry.org}</span>
          </div>
          <span class="font-mono text-micro text-muted-slate whitespace-nowrap tracking-mono">{entry.dates}</span>
        </div>
        <p class="font-sans text-caption text-muted-slate leading-[1.5] m-0">{entry.description}</p>
      </div>
    </li>
  ))}
</ol>