---
/**
 * GardenCard — card used on /garden and home preview grids.
 * image (optional) + type label + growth stage badge (optional) +
 * title + lede/excerpt + date + topic chips.
 * Uses Card.astro as base.
 */
import Card from './Card.astro';
import TopicChip from './TopicChip.astro';
import GrowthBadge from './GrowthBadge.astro';
import TopicPhoto from './TopicPhoto.astro';
import CuratedMark from './CuratedMark.astro';
import { pickArtTopic } from '@/lib/topics';

interface Props {
  title: string;
  type: 'note' | 'essay' | 'talk' | 'pattern' | 'practice' | 'project' | 'book';
  excerpt?: string;
  lede?: string;
  date: Date;
  topics?: string[];
  growthStage?: 'seedling' | 'growing' | 'evergreen';
  href: string;
  imageSrc?: string;
  class?: string;
  /** When set, if the date is within the past 30 days, render a ✦ mark. */
  newSince?: Date;
}

const {
  title,
  type,
  excerpt,
  lede,
  date,
  topics = [],
  growthStage,
  href,
  imageSrc,
  class: className = '',
  newSince,
} = Astro.props;

const displayText = excerpt ?? lede ?? '';

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(date);

const typeLabels = { note: 'Note', essay: 'Essay', talk: 'Talk', pattern: 'Pattern', practice: 'Practice', project: 'Project', book: 'Book' };

const NOW_MS = Date.now();
const THIRTY_DAYS_MS = 30 * 24 * 60 * 60 * 1000;
const isNew = newSince instanceof Date && (NOW_MS - newSince.getTime()) <= THIRTY_DAYS_MS;
---

<Card emphasis="bordered" class:list={['garden-card', className]}>
  <a href={href} class="block no-underline text-inherit">
    <div class="aspect-video overflow-hidden bg-soft-stone rounded-t-md">
      {imageSrc ? (
        <img src={imageSrc} alt="" loading="lazy" class="w-full h-full object-cover block" />
      ) : (
        <TopicPhoto
          topic={pickArtTopic(topics)}
          scale="sm"
          showCredit={false}
        />
      )}
    </div>

    <div class="p-7 md:p-8 flex flex-col gap-4">
      <div class="flex items-center flex-wrap gap-4">
        <span class="font-mono text-micro font-medium uppercase tracking-mono text-coral-text">{typeLabels[type]}</span>
        {growthStage && <GrowthBadge stage={growthStage} />}
        <time class="font-mono text-micro text-muted-slate ms-auto tracking-mono" datetime={date.toISOString()}>{formattedDate}</time>
      </div>

      <h3 class="font-display text-feature-heading font-normal text-ink leading-[1.25] tracking-display-tight m-0">
        {isNew && <CuratedMark size="sm" />}
        {title}
      </h3>

      {displayText && (
        <p class="font-sans text-caption text-muted-slate leading-[1.5] m-0 line-clamp-3 overflow-hidden">{displayText}</p>
      )}

      {topics.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-2">
          {topics.map((t) => <TopicChip label={t} />)}
        </div>
      )}
    </div>
  </a>
</Card>