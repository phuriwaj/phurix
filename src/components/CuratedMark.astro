---
/**
 * CuratedMark — single accent glyph for curated picks.
 * One glyph, one job: mark "currently featured" or "newly added."
 * Color: --color-coral-text (AA-safe coral text on canvas, both themes).
 * Cite as: DESIGN.md §7 (Component — accent glyph).
 */
interface Props {
  /** Visual size. Default 'md'. */
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { size = 'md', class: className = '' } = Astro.props;
const sizeClass = {
  sm: 'text-[0.9em]',
  md: 'text-[1.1em]',
  lg: 'text-[1.4em]',
}[size];
---

<span
  class:list={[
    'inline-block text-coral-text font-display leading-none align-[0.05em] me-2',
    sizeClass,
    className,
  ]}
  aria-hidden="true"
>✦</span>