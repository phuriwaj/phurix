---
/**
 * BookTile — library book cover tile.
 * Placeholder cover with title+author typography on color.
 * Currently-reading marker is a small coral pill (no gold).
 */
interface Props {
  title: string;
  author: string;
  coverColor: string;
  year?: number;
  /** Add a small coral "Reading" pill in the top-right. */
  currentlyReading?: boolean;
  /** DOM id (used by /library anchors from /garden deep-links). */
  id?: string;
  class?: string;
}

const {
  title,
  author,
  coverColor,
  year,
  currentlyReading = false,
  id,
  class: className = '',
} = Astro.props;
---

<div
  id={id}
  class:list={[
    'relative w-full aspect-[2/3] flex rounded-sm overflow-hidden border border-transparent',
    'transition-colors duration-200 hover:border-border-light',
    className,
  ]}
  style={`--book-color: ${coverColor}`}
>
  {currentlyReading && (
    <span class="absolute top-3 right-3 z-[2] font-mono text-micro font-medium text-ink bg-canvas border border-coral px-2.5 py-1 rounded-pill tracking-[0.02em] uppercase">
      Reading
    </span>
  )}
  <div class="flex-1 p-5 flex flex-col justify-end overflow-hidden relative" style={`background: var(--book-color);`}>
    <div class="relative z-[1] flex flex-col gap-1">
      <p class="font-display text-card-heading font-normal text-on-dark leading-[1.1] tracking-[-0.02em] m-0">{title}</p>
      <p class="font-sans text-caption text-on-dark/78 font-normal m-0">{author}</p>
      {year && <p class="font-mono text-micro text-on-dark/55 mt-1 tracking-[0.02em] m-0">{year}</p>}
    </div>
  </div>
</div>