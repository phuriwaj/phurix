---
/**
 * AnnouncementBar — full-width black strip above the Nav.
 * Cite as: DESIGN.md §4 (Layout — pre-nav announcement strip with close control).
 */
interface Props {
  /** The visible copy. Default: a low-key newsletter prompt. */
  message?: string;
  /** Optional link target for an inline "Learn more" link. */
  linkHref?: string;
  /** Label for the inline link. */
  linkLabel?: string;
  class?: string;
}

const {
  message = 'Subscribe — letters from a working library, no marketing.',
  linkHref = '/#newsletter',
  linkLabel = 'Learn more',
  class: className = '',
} = Astro.props;
---

<aside class:list={['flex items-center justify-center gap-4 bg-cohere-black text-on-dark px-5 h-14 font-sans text-micro text-center relative', className]} data-announce>
  <p class="m-0 leading-[1.4]">
    {message}
    {' '}
    <a href={linkHref} class="text-on-dark underline underline-offset-2 ms-1.5 hover:text-soft-coral transition-colors duration-button ease">{linkLabel}</a>
  </p>
  <button
    type="button"
    class="absolute end-4 top-1/2 -translate-y-1/2 text-on-dark-muted text-[1.4rem] leading-none w-4 h-4 inline-flex items-center justify-center transition-colors duration-button ease hover:text-on-dark"
    aria-label="Dismiss announcement"
    data-announce-close
  >×</button>
</aside>

<script>
  function initAnnouncement() {
    const bar = document.querySelector<HTMLElement>('[data-announce]');
    const close = document.querySelector<HTMLButtonElement>('[data-announce-close]');
    if (!bar || !close) return;
    if (sessionStorage.getItem('announce-dismissed') === '1') {
      bar.style.display = 'none';
      return;
    }
    close.addEventListener('click', () => {
      bar.style.display = 'none';
      sessionStorage.setItem('announce-dismissed', '1');
    });
  }

  initAnnouncement();
  document.addEventListener('astro:after-swap', initAnnouncement);
</script>