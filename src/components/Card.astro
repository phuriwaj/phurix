---
/**
 * Content Card — white or near-black surface.
 * Two emphasis levels: flat (no border) and bordered (1px hairline).
 * Dark variant: near-black background, on-dark text.
 * Image-wrap radius 22px hero media, 8px smaller variants.
 * Cite as: DESIGN.md §5 (Elevation & Depth — Flat / Bordered rows).
 */
interface Props {
  /** Visual emphasis level — "flat" has no border; "bordered" adds a hairline. */
  emphasis?: 'flat' | 'bordered';
  /** Full-bleed image at top of card. */
  imageSrc?: string;
  imageAlt?: string;
  /** Dark surface (near-black background). */
  tone?: 'light' | 'dark';
  class?: string;
  as?: 'div' | 'article' | 'section';
}

const props = Astro.props as Props;
const {
  emphasis = 'flat',
  imageSrc,
  imageAlt = '',
  tone = 'light',
  class: className = '',
  as: Tag = 'div',
} = props;
---

<Tag
  class:list={[
    'rounded-md overflow-hidden transition-[border-color,box-shadow] duration-200',
    tone === 'dark' ? 'bg-near-black text-on-dark' : 'bg-canvas text-ink',
    emphasis === 'bordered' && 'border border-hairline hover:border-border-light',
    className,
  ]}
>
  {imageSrc && (
    <div class="aspect-[4/5] overflow-hidden bg-soft-stone rounded-lg m-3 mb-0">
      <img src={imageSrc} alt={imageAlt} loading="lazy" class="w-full h-full object-cover object-center" />
    </div>
  )}
  <div class="p-5 md:p-7">
    <slot />
  </div>
</Tag>