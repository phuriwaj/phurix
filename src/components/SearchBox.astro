---
/**
 * SearchBox — nav-mounted site search.
 *
 * Embeds a build-time MiniSearch index of all content entries and renders a
 * dropdown of up to 8 results on input. Selection navigates to the entry.
 *
 * Keyboard:
 *   /         → focus the input (skip if user is already typing)
 *   Esc       → clear input + blur + close dropdown
 *   Arrow keys → move selection in dropdown (omitted — Enter navigates first result)
 *   Enter     → navigate to highlighted (or first) result
 *
 * Cite as: DESIGN.md §4 (Layout — nav-mounted search affordance between primary links and CTA).
 */
import { getSearchableEntries, type SearchableEntry } from '@/lib/search-index';

const entries: SearchableEntry[] = await getSearchableEntries();
const entriesJson = JSON.stringify(entries);

// Build-time index payload is carried to the client via a data-* attribute
// on the form. The hoisted <script> reads it on astro:page-load and feeds
// the entries into MiniSearch. This avoids a separate inline <script> for
// data handoff and keeps the markup self-contained.
---

<form
  class="max-md:hidden relative flex items-center gap-1 bg-soft-stone border border-hairline rounded-xs px-4 h-9 min-w-[180px] transition-[border-color,box-shadow] duration-button ease focus-within:border-focus-blue focus-within:shadow-focus-ring focus-within:bg-canvas"
  role="search"
  data-searchbox
  data-searchbox-entries={entriesJson}
  autocomplete="off"
  onsubmit="return false;"
>
  <label class="sr-only" for="searchbox-input">Search</label>
  <span class="inline-flex text-muted-slate flex-shrink-0" aria-hidden="true">
    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="7" cy="7" r="5"></circle>
      <line x1="11" y1="11" x2="14" y2="14" stroke-linecap="round"></line>
    </svg>
  </span>
  <input
    id="searchbox-input"
    class="flex-1 border-0 bg-transparent font-sans text-caption text-ink outline-none min-w-0 placeholder:text-muted-slate [&::-webkit-search-cancel-button]:appearance-none"
    type="search"
    placeholder="Search…"
    aria-label="Search"
    aria-autocomplete="list"
    aria-controls="searchbox-results"
    aria-expanded="false"
    data-searchbox-input
  />
  <kbd class="font-mono text-micro text-muted-slate bg-canvas border border-hairline rounded px-1.5 py-0 leading-snug flex-shrink-0 focus-within:opacity-0" aria-hidden="true">/</kbd>

  <div
    class="absolute top-[calc(100%+6px)] right-0 left-0 min-w-[320px] max-w-[480px] bg-canvas border border-hairline rounded-md shadow-card z-50 overflow-hidden [&[hidden]]:hidden"
    role="listbox"
    id="searchbox-results"
    data-searchbox-dropdown
    hidden
  >
    <ul class="list-none m-0 py-2 max-h-[70vh] overflow-y-auto" data-searchbox-list></ul>
    <a
      class="block px-5 py-4 border-t border-hairline font-sans text-caption text-action-blue no-underline text-center font-medium hover:bg-soft-stone"
      href="/search/"
      data-searchbox-see-all
    >See all results</a>
  </div>
</form>

<script>
  // Hoisted module — bundled by Astro. Re-runs on every view-transition nav
  // because it listens to astro:page-load (not DOMContentLoaded).
  import MiniSearch from 'minisearch';

  type SearchableEntry = {
    collection: string;
    slug: string;
    title: string;
    excerpt: string;
    topics: string[];
    date: string;
    href: string;
  };

  const TYPE_LABELS: Record<string, string> = {
    note: 'Note',
    essay: 'Essay',
    talk: 'Talk',
    book: 'Book',
    pattern: 'Pattern',
    project: 'Project',
    practice: 'Practice',
  };

  const DATE_FMT = new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });

  function formatDate(iso: string): string {
    if (!iso || iso.startsWith('1970-01-01T00:00:00') || iso.startsWith('0000-')) {
      return '';
    }
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '';
    return DATE_FMT.format(d);
  }

  function buildIndex(entries: SearchableEntry[]): MiniSearch<SearchableEntry> {
    const ms = new MiniSearch<SearchableEntry>({
      fields: ['title', 'excerpt', 'topics'],
      storeFields: ['collection', 'slug', 'title', 'excerpt', 'topics', 'date', 'href'],
      searchOptions: {
        boost: { title: 3, topics: 2, excerpt: 1 },
        prefix: true,
        fuzzy: 0.2,
        combineWith: 'AND',
      },
    });
    ms.addAll(entries);
    return ms;
  }

  function isTypingTarget(el: EventTarget | null): boolean {
    if (!(el instanceof HTMLElement)) return false;
    const tag = el.tagName;
    return (
      tag === 'INPUT' ||
      tag === 'TEXTAREA' ||
      tag === 'SELECT' ||
      el.isContentEditable
    );
  }

  function renderResults(
    list: HTMLElement,
    dropdown: HTMLElement,
    entries: SearchableEntry[],
  ): void {
    if (entries.length === 0) {
      list.innerHTML = '<li class="searchbox-empty">No matches</li>';
      dropdown.removeAttribute('hidden');
      return;
    }

    list.innerHTML = entries
      .map((e, i) => {
        const dateLabel = formatDate(e.date);
        const typeLabel = TYPE_LABELS[e.collection] ?? e.collection;
        return `
          <li>
            <a
              class="searchbox-result"
              href="${e.href}"
              role="option"
              data-active="${i === 0 ? 'true' : 'false'}"
              data-searchbox-result
            >
              <div class="searchbox-result-meta">
                <span class="searchbox-result-type">${typeLabel}</span>
                ${dateLabel ? `<time datetime="${e.date}">${dateLabel}</time>` : ''}
              </div>
              <p class="searchbox-result-title">${escapeHtml(e.title)}</p>
              ${e.excerpt ? `<p class="searchbox-result-excerpt">${escapeHtml(e.excerpt)}</p>` : ''}
            </a>
          </li>
        `;
      })
      .join('');

    dropdown.removeAttribute('hidden');
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function setActiveResult(list: HTMLElement, index: number): void {
    const results = list.querySelectorAll<HTMLElement>('[data-searchbox-result]');
    results.forEach((r, i) => r.setAttribute('data-active', i === index ? 'true' : 'false'));
  }

  function setupSearchBox(root: HTMLElement): void {
    const input = root.querySelector<HTMLInputElement>('[data-searchbox-input]');
    const dropdown = root.querySelector<HTMLElement>('[data-searchbox-dropdown]');
    const list = root.querySelector<HTMLElement>('[data-searchbox-list]');
    if (!input || !dropdown || !list) return;

    let mini: MiniSearch<SearchableEntry> | null = null;
    let activeIndex = 0;

    const dataJson = root.getAttribute('data-searchbox-entries');
    if (!dataJson) return;
    let entries: SearchableEntry[];
    try {
      entries = JSON.parse(dataJson) as SearchableEntry[];
    } catch {
      return;
    }

    const open = () => {
      dropdown.removeAttribute('hidden');
      input.setAttribute('aria-expanded', 'true');
    };

    const close = () => {
      dropdown.setAttribute('hidden', '');
      input.setAttribute('aria-expanded', 'false');
      activeIndex = 0;
    };

    const performSearch = (raw: string) => {
      const q = raw.trim();
      if (!q) {
        close();
        return;
      }
      if (!mini) mini = buildIndex(entries);
      const hits = mini.search(q).slice(0, 8) as unknown as SearchableEntry[];
      renderResults(list, dropdown, hits);
      activeIndex = 0;
      open();
    };

    input.addEventListener('input', () => performSearch(input.value));
    input.addEventListener('focus', () => {
      if (input.value.trim()) performSearch(input.value);
    });

    input.addEventListener('keydown', (e) => {
      const results = list.querySelectorAll<HTMLAnchorElement>('[data-searchbox-result]');

      if (e.key === 'Escape') {
        e.preventDefault();
        input.value = '';
        close();
        input.blur();
        return;
      }

      if (e.key === 'Enter') {
        const query = input.value.trim();
        if (results.length === 0) {
          // posthog is optional; only fires when SDK initialised with a key.
          // eslint-disable-next-line @typescript-eslint/no-explicit-any
          const ph = (window as any).posthog;
          ph?.capture?.('search_no_results', { query, source_path: window.location.pathname });
          window.location.href = `/search/?q=${encodeURIComponent(query)}`;
          return;
        }
        const target = results[activeIndex] ?? results[0];
        e.preventDefault();
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const ph = (window as any).posthog;
        ph?.capture?.('search_result_click', {
          query,
          position: activeIndex,
          href: target.getAttribute('href') ?? '',
          source_path: window.location.pathname,
        });
        window.location.href = target.href;
        return;
      }

      if (e.key === 'ArrowDown') {
        if (results.length === 0) return;
        e.preventDefault();
        activeIndex = (activeIndex + 1) % results.length;
        setActiveResult(list, activeIndex);
        results[activeIndex].scrollIntoView({ block: 'nearest' });
        return;
      }

      if (e.key === 'ArrowUp') {
        if (results.length === 0) return;
        e.preventDefault();
        activeIndex = (activeIndex - 1 + results.length) % results.length;
        setActiveResult(list, activeIndex);
        results[activeIndex].scrollIntoView({ block: 'nearest' });
        return;
      }
    });

    list.addEventListener('mouseover', (e) => {
      const target = e.target as HTMLElement;
      const anchor = target.closest<HTMLAnchorElement>('[data-searchbox-result]');
      if (!anchor) return;
      const results = Array.from(
        list.querySelectorAll<HTMLAnchorElement>('[data-searchbox-result]'),
      );
      const idx = results.indexOf(anchor);
      if (idx >= 0) {
        activeIndex = idx;
        setActiveResult(list, idx);
      }
    });

    list.addEventListener('click', (e) => {
      const anchor = (e.target as HTMLElement | null)?.closest<HTMLAnchorElement>(
        '[data-searchbox-result]',
      );
      if (!anchor) return;
      const results = Array.from(
        list.querySelectorAll<HTMLAnchorElement>('[data-searchbox-result]'),
      );
      const idx = results.indexOf(anchor);
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const ph = (window as any).posthog;
      ph?.capture?.('search_result_click', {
        query: input.value.trim(),
        position: idx >= 0 ? idx : 0,
        href: anchor.getAttribute('href') ?? '',
        source_path: window.location.pathname,
        trigger: 'mouse',
      });
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== '/') return;
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      if (isTypingTarget(e.target)) return;
      e.preventDefault();
      input.focus();
      input.select();
    });
  }

  function init(): void {
    document
      .querySelectorAll<HTMLElement>('[data-searchbox]')
      .forEach(setupSearchBox);
  }

  document.addEventListener('astro:page-load', init);
</script>

<style>
  /* Result-item styles for HTML injected by the script — Tailwind can't
     reach into JS-rendered markup cleanly, so a small scoped sheet covers
     the dynamic result rows. */
  .searchbox-result {
    display: block;
    padding: var(--spacing-4) var(--spacing-5);
    text-decoration: none;
    color: inherit;
    border-left: 2px solid transparent;
  }

  .searchbox-result:hover,
  .searchbox-result[data-active="true"] {
    background: var(--color-soft-stone);
    border-left-color: var(--color-focus-blue);
  }

  .searchbox-result-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-muted-slate);
    margin-bottom: 2px;
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .searchbox-result-type {
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    font-weight: 500;
    color: var(--color-coral-text);
  }

  .searchbox-result-title {
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 400;
    color: var(--color-ink);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-display-tight);
    margin: 0 0 2px 0;
  }

  .searchbox-result-excerpt {
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted-slate);
    line-height: var(--leading-body);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .searchbox-empty {
    padding: var(--spacing-5);
    font-family: var(--font-sans);
    font-size: var(--text-caption);
    color: var(--color-muted-slate);
    text-align: center;
  }
</style>