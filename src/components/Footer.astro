const findMoreLinks = [
  { label: 'Garden', href: '/garden' },
  { label: 'Essays', href: '/essays' },
  { label: 'Notes', href: '/notes' },
  { label: 'Patterns', href: '/patterns' },
  { label: 'Practices', href: '/practices' },
  { label: 'Now', href: '/now' },
  { label: 'Projects', href: '/projects' },
  { label: 'Graph', href: '/graph' },
  { label: 'Library', href: '/library' },
  { label: 'Talks', href: '/talks' },
  { label: 'Contact', href: '/contact' },
  { label: 'Colophon', href: '/colophon' },
  { label: 'Concepts', href: '/concepts' },
];

const year = new Date().getFullYear();
---

<footer id="newsletter" class="mt-15 bg-near-black text-on-dark py-15">
  <div class="max-w-[1440px] mx-auto px-7 grid grid-cols-1 md:grid-cols-[1fr_2fr_1fr] gap-12 md:gap-14 md:items-start">
    {/* --- Cluster 1 — Subscribe ------------------------------ */}
    <div class="min-w-0">
      <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral m-0 mb-5">AI moves fast</p>
      <p class="font-sans text-body text-on-dark-muted leading-[1.5] m-0 mb-7 max-w-[36ch]">
        Letters from a working library, when there's something worth sharing.
      </p>
      <form action="/api/subscribe" method="post" class="flex items-center gap-2 bg-white/[0.06] border border-white/[0.18] rounded-pill py-1 ps-7 pe-1 max-w-[360px] transition-[border-color,box-shadow] duration-button ease focus-within:border-focus-blue focus-within:shadow-focus-ring">
        <label for="footer-email" class="sr-only">Email address</label>
        <input
          type="email"
          id="footer-email"
          name="email"
          placeholder="your@email.com"
          class="flex-1 bg-transparent border-0 outline-none text-on-dark font-sans text-body py-1.5 min-w-0 placeholder:text-on-dark-muted"
          required
        />
        <button type="submit" aria-label="Subscribe" class="w-9 h-9 rounded-full bg-on-dark text-near-black inline-flex items-center justify-center transition-colors duration-button ease hover:bg-soft-coral">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="8" x2="13" y2="8" />
            <polyline points="9,4 13,8 9,12" />
          </svg>
        </button>
      </form>
    </div>

    {/* --- Cluster 2 — Find more ------------------------------ */}
    <div class="min-w-0">
      <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral m-0 mb-5">Find more</p>
      <ul class="list-none p-0 m-0 flex flex-wrap gap-x-7 gap-y-4">
        {findMoreLinks.map((link) => (
          <li>
            <a href={link.href} class="text-on-dark-muted no-underline font-sans text-caption transition-colors duration-button ease hover:text-on-dark">{link.label}</a>
          </li>
        ))}
        <li>
          <details class="inline-block [&_summary]:cursor-pointer [&_summary]:list-none [&_summary]:text-on-dark-muted [&_summary]:font-sans [&_summary]:text-caption [&_summary]:transition-colors [&_summary]:duration-button [&_summary]:ease [&_summary:hover]:text-on-dark [&_summary::-webkit-details-marker]:hidden">
            <summary class="hover:text-on-dark [open]:text-on-dark">Blogroll</summary>
            <ul class="list-none p-0 mt-5 grid grid-cols-1 md:grid-cols-2 gap-2">
              {blogroll.map((entry) => (
                <li>
                  <a
                    href={entry.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-on-dark-muted font-sans text-caption no-underline transition-colors duration-button ease hover:text-on-dark"
                  >
                    {entry.name}
                  </a>
                  {entry.blurb && <span class="text-on-dark-muted opacity-70 font-sans text-micro ms-1"> — {entry.blurb}</span>}
                </li>
              ))}
            </ul>
          </details>
        </li>
        <li>
          <a href="/rss.xml" class="text-on-dark-muted no-underline font-sans text-caption transition-colors duration-button ease hover:text-on-dark">RSS</a>
        </li>
      </ul>
    </div>

    {/* --- Cluster 3 — Social + brand ------------------------- */}
    <div class="min-w-0 flex flex-col items-start md:items-end md:text-right gap-5">
      <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral m-0 mb-0">Elsewhere</p>
      <div class="flex items-center gap-7">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            aria-label={link.label}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="text-on-dark-muted transition-colors duration-button ease flex items-center justify-center hover:text-on-dark"
          >
            <span class="block w-5 h-5 [&_svg]:w-full [&_svg]:h-full" set:html={link.icon} />
          </a>
        ))}
      </div>
      <small class="font-sans text-micro text-on-dark-muted">
        © {year} Phuriwaj Ruengnaowaroj · Built with care · <a href="/colophon" class="text-on-dark-muted no-underline underline underline-offset-2 hover:text-on-dark transition-colors duration-button ease">Colophon</a>
      </small>
    </div>
  </div>
</footer>