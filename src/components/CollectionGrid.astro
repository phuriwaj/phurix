---
/**
 * CollectionGrid — responsive grid layout for content collections.
 * 1 col mobile → 2 col tablet (≥768px) → 3 col desktop (≥1024px).
 * Optional `tone` prop tints the grid background for a wash effect.
 * Cite as: DESIGN.md §5 (Spacing — gap scale + grid breakpoints).
 */
interface Props {
  cols?: 1 | 2 | 3;
  gap?: 'sm' | 'md' | 'lg';
  /** Optional background tone for the grid container. */
  tone?: 'none' | 'pale-green' | 'pale-blue';
  class?: string;
}

const { cols = 3, gap = 'md', tone = 'none', class: className = '' } = Astro.props;

const gapClass = {
  sm: 'gap-7',
  md: 'gap-10',
  lg: 'gap-12',
}[gap];

const colsClass = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 md:grid-cols-2',
  3: 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3',
}[cols];

const toneClass =
  tone === 'pale-green'
    ? 'bg-pale-green-wash p-10 rounded-md'
    : tone === 'pale-blue'
      ? 'bg-pale-blue-wash p-10 rounded-md'
      : 'bg-transparent';
---

<div class:list={['grid', colsClass, gapClass, toneClass, className]}>
  <slot />
</div>