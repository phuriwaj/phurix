---
/**
 * CuratedPicks — curated picks block.
 * Renders an <ol> where each item is "✦ <a href=...>{title}</a>"
 * separated by hairline <hr>s. Used on / and /essays.
 * Cite as: DESIGN.md §7 (Component — curated picks block).
 */
import CuratedMark from './CuratedMark.astro';

interface Props {
  /** Each entry: a title + href. The ✦ mark is added automatically. */
  items: Array<{ title: string; href: string }>;
  /** Optional heading shown above the block. Default: no heading. */
  heading?: string;
  class?: string;
}

const { items, heading, class: className = '' } = Astro.props;
---

<div class:list={['w-full', className]}>
  {heading && (
    <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral-text mb-5">{heading}</p>
  )}
  <ol class="list-none p-0 m-0 max-w-[60ch]">
    {items.map((item) => (
      <li class="flex items-baseline py-5 border-t border-hairline last:border-b border-hairline">
        <CuratedMark size="md" />
        <a href={item.href} class="font-display italic text-body-lg font-normal text-action-blue no-underline tracking-display-tight transition-colors duration-button ease hover:text-heading hover:underline hover:underline-offset-2 hover:[text-decoration-thickness:2px]">{item.title}</a>
      </li>
    ))}
  </ol>
</div>