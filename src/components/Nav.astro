---
/**
 * Global Navigation — fixed top bar.
 * Single nav height per device tier (mobile/desktop).
 * Bottom hairline divider; no soft shadow.
 *
 * Cite as: DESIGN.md §4 (Layout — nav chrome).
 */
import SearchBox from '@/components/SearchBox.astro';
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/garden', label: 'Garden' },
  { href: '/essays', label: 'Essays' },
  { href: '/notes', label: 'Notes' },
  { href: '/patterns', label: 'Patterns' },
  { href: '/now', label: 'Now' },
  { href: '/random', label: 'Random' },
];

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  if (href === '/random') return false; // redirect endpoint, never active
  if (href === '/now') return pathname === '/now';
  return pathname === href || pathname.startsWith(href + '/');
};
---

<header class="fixed top-0 left-0 right-0 z-40 bg-canvas border-b border-hairline h-14 md:h-[7.2rem]">
  <div class="h-full max-w-[1440px] mx-auto px-7 flex items-center gap-7">
    {/* Wordmark */}
    <a href="/" aria-label="phurix home">
      <span class="font-display font-medium text-[1.8rem] tracking-display-tight text-heading">phurix</span>
    </a>

    {/* Hamburger — mobile only */}
    <button
      type="button"
      class="md:hidden inline-flex ms-auto flex-col justify-center items-center gap-1 w-10 h-10 rounded cursor-pointer [&[aria-expanded=true]_span:nth-child(1)]:translate-y-[6px] [&[aria-expanded=true]_span:nth-child(1)]:rotate-45 [&[aria-expanded=true]_span:nth-child(2)]:opacity-0 [&[aria-expanded=true]_span:nth-child(3)]:-translate-y-[6px] [&[aria-expanded=true]_span:nth-child(3)]:-rotate-45"
      aria-label="Toggle navigation"
      aria-controls="nav-mobile-menu"
      aria-expanded="false"
      data-nav-toggle
    >
      <span class="block w-[22px] h-0.5 bg-heading rounded-sm transition-[transform,opacity] duration-button ease" aria-hidden="true"></span>
      <span class="block w-[22px] h-0.5 bg-heading rounded-sm transition-[transform,opacity] duration-button ease" aria-hidden="true"></span>
      <span class="block w-[22px] h-0.5 bg-heading rounded-sm transition-[transform,opacity] duration-button ease" aria-hidden="true"></span>
    </button>

    {/* Primary links (desktop) */}
    <nav class="hidden md:flex gap-7" aria-label="Primary">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'font-sans text-caption font-medium text-ink py-1 transition-colors duration-button ease no-underline relative hover:text-action-blue',
            isActive(link.href) && 'text-heading after:content-[""] after:absolute after:-bottom-0.5 after:left-0 after:right-0 after:h-0.5 after:bg-heading after:rounded-sm',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    {/* SearchBox — right cluster, after primary links */}
    <div class="hidden md:flex ms-auto">
      <SearchBox />
    </div>

    {/* Theme toggle — visible on all viewports, small a11y affordance */}
    <button
      type="button"
      class="relative w-8 h-8 inline-flex items-center justify-center bg-transparent border-0 rounded-sm text-ink cursor-pointer transition-colors duration-button ease p-0 hover:bg-soft-stone focus-visible:outline-none focus-visible:shadow-focus-ring"
      aria-label="Toggle dark mode"
      data-theme-toggle
    >
      <span class="absolute text-[1.6rem] leading-none transition-opacity duration-button ease opacity-0 invisible [html[data-theme=dark]_&]:opacity-100 [html[data-theme=dark]_&]:visible" aria-hidden="true">☀</span>
      <span class="absolute text-[1.6rem] leading-none transition-opacity duration-button ease opacity-100 visible [html[data-theme=dark]_&]:opacity-0 [html[data-theme=dark]_&]:invisible" aria-hidden="true">☾</span>
    </button>
  </div>

  {/* Mobile menu — appears below the bar when hamburger is open */}
  <nav
    id="nav-mobile-menu"
    class="md:hidden flex flex-col gap-0 bg-canvas border-t border-hairline px-7 py-4 [&[hidden]]:hidden [&:not([hidden])]:block"
    aria-label="Primary mobile"
    data-nav-mobile
    hidden
  >
    {navLinks.map((link) => (
      <a
        href={link.href}
        class:list={[
          'block font-sans text-body font-medium text-ink py-5 no-underline border-b border-hairline last:border-b-0 hover:text-action-blue transition-colors duration-button ease',
          isActive(link.href) && 'text-heading',
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

<script>
  function initNavToggle() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-nav-mobile]');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
      if (isOpen) {
        menu.setAttribute('hidden', '');
      } else {
        menu.removeAttribute('hidden');
      }
    });
  }

  initNavToggle();
  document.addEventListener('astro:after-swap', initNavToggle);

  function applyTheme(theme: 'light' | 'dark') {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem('phurix-theme', theme);
  }

  function initThemeToggle() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!toggle) return;
    toggle.addEventListener('click', () => {
      const current: 'light' | 'dark' =
        document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      applyTheme(current === 'dark' ? 'light' : 'dark');
    });
  }

  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>