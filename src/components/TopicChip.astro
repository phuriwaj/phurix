---
/**
 * TopicChip — pill chip for topic tags and filters.
 * Mono uppercase outline, coral color, active inverts to coral fill.
 * Cite as: DESIGN.md §7 (blog-filter-chip).
 */
interface Props {
  label: string;
  active?: boolean;
  href?: string;
  /** Visual size. sm (12px), md (14px default), lg (18px). */
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { label, active = false, href, size = 'md', class: className = '' } = Astro.props;

const Tag = href ? 'a' : 'span';

const sizeClass = {
  sm: 'text-micro py-0.5 px-3 rounded-pill',
  md: 'text-button py-1 px-3 rounded-pill',
  lg: 'text-body-lg py-2 px-5 rounded-xl',
}[size];
---

<Tag
  href={href}
  data-topic-chip={label}
  class:list={[
    'inline-block font-mono uppercase tracking-[0.02em] bg-transparent text-coral-text border border-coral no-underline cursor-pointer leading-relaxed',
    'transition-[background-color,color,border-color] duration-200',
    sizeClass,
    active && 'bg-coral text-cohere-black border-coral',
    !active && 'hover:bg-coral/10',
    active && 'hover:bg-soft-coral hover:border-soft-coral',
    className,
  ]}
>
  {label}
</Tag>