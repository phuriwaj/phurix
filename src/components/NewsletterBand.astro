---
/**
 * NewsletterBand — near-black subscribe band.
 * Cite as: DESIGN.md §7 (Component — subscribe band).
 *
 * Coral mono eyebrow, white display headline, white input, white submit pill.
 */
interface Props {
  /** Override the default headline. */
  headline?: string;
  /** Override the default subhead. */
  subhead?: string;
  /** Form submit target. */
  action?: string;
  /** CTA label. */
  ctaLabel?: string;
  class?: string;
}

const {
  headline = 'Letters from a working library.',
  subhead = "Occasional notes from the studio — essays, experiments, things I'm thinking about. No spam, no marketing. Just a short dispatch when there's something worth sharing.",
  ctaLabel = 'Subscribe',
  action = '/api/subscribe',
  class: className = '',
} = Astro.props;
---

<section class:list={['bg-near-black text-on-dark rounded-md p-10 md:p-14', className]}>
  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-10 md:gap-14">
    <div class="flex-1 max-w-[50ch]">
      <p class="font-mono text-mono-label font-medium uppercase tracking-mono text-coral m-0 mb-5">AI moves fast</p>
      <h2 class="font-display text-card-heading font-normal text-on-dark leading-[1.2] tracking-display-tight m-0 mb-5">{headline}</h2>
      <p class="font-sans text-body text-on-dark-muted leading-[1.5] m-0">{subhead}</p>
    </div>
    <form action={action} method="post" data-newsletter class="flex flex-col min-[480px]:flex-row min-[480px]:items-start gap-5 min-w-[280px]">
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        type="email"
        id="newsletter-email"
        name="email"
        placeholder="your@email.com"
        class="flex-1 px-6 py-3 font-sans text-body text-ink bg-canvas border border-canvas rounded-pill outline-none min-w-0 transition-[border-color,box-shadow] duration-button ease placeholder:text-muted-slate focus:border-form-violet focus:shadow-form-focus"
        required
      />
      <button type="submit" class="px-6 py-3 font-sans text-body font-medium text-near-black bg-on-dark border border-on-dark rounded-pill cursor-pointer tracking-tight transition-[background-color,color,border-color] duration-button ease hover:bg-soft-coral hover:border-soft-coral">{ctaLabel}</button>
    </form>
  </div>
</section>

<script>
  // Fire-and-forget capture on newsletter submit. We don't await the form
  // POST — letting the browser proceed with the submit while posthog batches
  // the event in the background. posthog is optional (no-op when PUBLIC_POSTHOG_KEY
  // is unset).
  function init(): void {
    document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
      form.addEventListener('submit', () => {
        const email = (form.querySelector<HTMLInputElement>('input[type="email"]')?.value ?? '').trim();
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        const ph = (window as any).posthog;
        ph?.capture?.('newsletter_submit_attempt', {
          source_path: window.location.pathname,
          email_domain: email.includes('@') ? email.split('@')[1] : null,
        });
      });
    });
  }

  document.addEventListener('astro:page-load', init);
</script>